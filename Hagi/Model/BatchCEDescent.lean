import Hagi.Model.CEDescent
import Hagi.Probability.FiniteFamilyConfidence
import Hagi.Step.ProjectionDescent
import Hagi.Step.SafeQPStep

/-!
# Common-direction arithmetic-batch cross-entropy descent

This module proves a one-step majorization certificate for the raw arithmetic
mean of one-hot cross-entropy losses on a supplied finite batch.  The common
parameter direction is the arithmetic mean of the existing per-example
negative residual directions.  Its mean directional action is exactly minus
the squared norm of the mean residual transpose, and the quadratic coefficient
uses the arithmetic mean of the squared logit ranges of that same direction.

For an arbitrary common direction and nonnegative step, the existing Böhning
bound `Hagi.Energy.lse_shift_upper` controls second-order error; this is not a
probability tail theorem.  The selected safe step is zero when the mean squared
range is zero.  Otherwise it minimizes the named averaged quadratic majorizer
and gives strict descent of the actual arithmetic-mean batch loss.  Positive
mean squared range implies a nonempty batch and positive alignment.

The results concern only the supplied batch and quadratic majorizer.  A second
candidate is the totalized minimum-norm point of the raw residual-gradient
convex hull.  Its negative gives nonincreasing CE for every sample, with strict
descent at a nonzero minimizer inside the exact half-window.  Empty batches and
zero minimizers use a zero step, with no fabricated strict-progress claim.

These are formal one-step certificates, not global CE minimization, held-out or
statistical performance, native execution speed, or general neural-network
optimality results.  Empty-batch mean values use Lean's `0 / 0 = 0` algebra
convention.

References are the repository implementations in `Model.CEDescent`,
`Model.CEGradient`, and `Energy.PoEBound`.
-/

set_option relaxedAutoImplicit false

open scoped Matrix
open InnerProductSpace

namespace Hagi.Model.BatchCEDescent

/-- One parameter update along an arbitrary common direction. -/
noncomputable def alongNext {d : ℕ} (θ D : EuclideanSpace ℝ (Fin d)) (eta : ℝ) :
    EuclideanSpace ℝ (Fin d) :=
  θ + eta • D

/-- One-unit range coefficient for an arbitrary direction. -/
noncomputable def dirRange {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) : ℝ :=
  2 * ∑ v, |ceLogits X D v|

/-- Exact residual action on the logits generated by an arbitrary direction. -/
noncomputable def dirAction {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V)
    (D : EuclideanSpace ℝ (Fin d)) : ℝ :=
  ∑ v, ceResidual X θ t v * ceLogits X D v

/-- The full quadratic majorizer in an arbitrary direction. -/
noncomputable def dirMajorizer {V : Type} [Fintype V] [Nonempty V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V)
    (D : EuclideanSpace ℝ (Fin d)) (eta : ℝ) : ℝ :=
  Hagi.ceOneHot t (ceLogits X θ) + eta * dirAction X θ t D
    + (eta * dirRange X D) ^ 2 / 8

@[simp] theorem alongNext_zero {d : ℕ} (θ D : EuclideanSpace ℝ (Fin d)) :
    alongNext θ D 0 = θ := by
  simp [alongNext]

/-- Matrix multiplication turns the common parameter displacement into the
same eta-scaled logit displacement for every sample. -/
theorem ceLogits_alongNext_apply {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (eta : ℝ) (v : V) :
    ceLogits X (alongNext θ D eta) v = ceLogits X θ v + eta * ceLogits X D v := by
  simp only [alongNext, ceLogits, Matrix.mulVec, dotProduct, PiLp.add_apply,
    PiLp.smul_apply, smul_eq_mul, Finset.mul_sum, mul_add,
    Finset.sum_add_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro j _hj
  ring

/-- Exact first-order displacement law for an arbitrary direction. -/
theorem dir_first_order_eq {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d)) (t : V)
    (eta : ℝ) :
    ∑ v, ceResidual X θ t v *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      eta * dirAction X θ t D := by
  simp only [ceLogits_alongNext_apply, add_sub_cancel_left, dirAction,
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro v _hv
  ring

set_option linter.unusedDecidableInType false in
/-- The existing Fréchet derivative has exactly the `dirAction` form. -/
theorem fderiv_dirAction {V : Type} [Fintype V] [Nonempty V] [DecidableEq V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) :
    fderiv ℝ (fun w : EuclideanSpace ℝ (Fin d) =>
      Hagi.ceOneHot t (ceLogits X w)) θ D = dirAction X θ t D := by
  simp only [ceLogits]
  rw [CEGradient.fderiv_ceOneHot_mulVec]
  apply Finset.sum_congr rfl
  intro v _hv
  by_cases hv : v = t <;>
    simp [ceResidual, ceLogits, Hagi.Energy.smax, hv]

/-- The arbitrary-direction range coefficient is nonnegative. -/
theorem dirRange_nonneg {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) :
    0 ≤ dirRange X D := by
  unfold dirRange
  positivity

/-- At nonnegative eta the actual displacement satisfies the range premise
needed by the existing `lse_shift_upper`, with no premise omitted. -/
theorem dir_displacement_range {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    {eta : ℝ} (heta : 0 ≤ eta) (u v : V) :
    (ceLogits X (alongNext θ D eta) u - ceLogits X θ u)
      - (ceLogits X (alongNext θ D eta) v - ceLogits X θ v)
      ≤ eta * dirRange X D := by
  have hsub : ∀ w : V, |ceLogits X D w| ≤ ∑ z, |ceLogits X D z| := by
    intro w
    exact Finset.single_le_sum
      (fun z _hz => abs_nonneg (ceLogits X D z)) (Finset.mem_univ w)
  have htri : ceLogits X D u - ceLogits X D v ≤
      |ceLogits X D u| + |ceLogits X D v| := by
    exact le_trans (le_abs_self _) (abs_sub _ _)
  rw [ceLogits_alongNext_apply, ceLogits_alongNext_apply]
  have hmul := mul_le_mul_of_nonneg_left
    (add_le_add (hsub u) (hsub v)) heta
  have hmul' := mul_le_mul_of_nonneg_left htri heta
  dsimp [dirRange]
  linarith

/-- Zero range is exactly joint vanishing of all directional logits. -/
theorem dirRange_eq_zero_iff {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) :
    dirRange X D = 0 ↔ ∀ v, ceLogits X D v = 0 := by
  constructor
  · intro hr v
    have hsum : ∑ w, |ceLogits X D w| = 0 := by
      dsimp [dirRange] at hr
      linarith
    have habs := (Finset.sum_eq_zero_iff_of_nonneg
      (fun w _hw => abs_nonneg (ceLogits X D w))).mp hsum
      v (Finset.mem_univ v)
    exact abs_eq_zero.mp habs
  · intro hv
    simp [dirRange, hv]

/-- General one-example Böhning upper bound along an arbitrary direction. -/
theorem ceOneHot_alongNext_le_majorizer {V : Type} [Fintype V] [Nonempty V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) {eta : ℝ} (heta : 0 ≤ eta) :
    Hagi.ceOneHot t (ceLogits X (alongNext θ D eta)) ≤
      dirMajorizer X θ t D eta := by
  have hlse := Hagi.Energy.lse_shift_upper (ceLogits X θ)
    (ceLogits X (alongNext θ D eta)) (eta * dirRange X D)
    (dir_displacement_range X θ D heta)
  have hlin := dir_first_order_eq X θ D t eta
  have ht := ceLogits_alongNext_apply X θ D eta t
  classical
  have honehot : ∑ v, (if v = t then (1 : ℝ) else 0) *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      ceLogits X (alongNext θ D eta) t - ceLogits X θ t := by
    simp
  simp only [ceResidual, sub_mul, Finset.sum_sub_distrib] at hlin
  rw [honehot, ht] at hlin
  have hsoft : ∑ v, Hagi.Energy.smax (ceLogits X θ) v *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      eta * dirAction X θ t D + eta * ceLogits X D t := by
    linarith
  rw [hsoft] at hlse
  unfold Hagi.ceOneHot Hagi.Core.lse
  unfold dirMajorizer
  rw [ht]
  dsimp [Hagi.Core.ceOneHot, Hagi.Core.lse]
  linarith

/-- Expanded general majorization certificate, retaining eta and range. -/
theorem ceOneHot_alongNext_le {V : Type} [Fintype V] [Nonempty V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) {eta : ℝ} (heta : 0 ≤ eta) :
    Hagi.ceOneHot t (ceLogits X (alongNext θ D eta)) ≤
      Hagi.ceOneHot t (ceLogits X θ) + eta * dirAction X θ t D
        + (eta * dirRange X D) ^ 2 / 8 :=
  ceOneHot_alongNext_le_majorizer X θ D t heta

/-! ## Arithmetic batch: one common averaged direction -/

/-- Raw arithmetic mean CE on the supplied samples.  The empty-batch value is
Lean's `0 / 0 = 0` algebra convention, not a statistical estimate. -/
noncomputable def batchLoss {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ :=
  Hagi.Probability.FiniteFamilyConfidence.empiricalMean
    (fun b t => Hagi.ceOneHot t (ceLogits (X b) θ)) y

/-- Coordinatewise arithmetic mean of the exact residual transposes. -/
noncomputable def meanResidualTranspose {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : Fin d → ℝ :=
  fun j => (∑ b, residualTranspose (X b) θ (y b) j) / (B : ℝ)

/-- Arithmetic mean of the individual negative-residual directions.  This is
the one common direction used in every individual majorizer below. -/
noncomputable def batchMeanDirection {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : EuclideanSpace ℝ (Fin d) :=
  WithLp.toLp 2 (fun j =>
    (∑ b, (ceDirection (X b) θ (y b)).ofLp j) / (B : ℝ))

/-- Alignment is based on the mean residual transpose, never on a mean of
individual alignments. -/
noncomputable def batchAlignment {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ :=
  ∑ j, (meanResidualTranspose X θ y j) ^ 2

/-- Arithmetic mean of the squared ranges of the *same* common direction. -/
noncomputable def batchRangeSquare {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ :=
  (∑ b, (dirRange (X b) (batchMeanDirection X θ y)) ^ 2) / (B : ℝ)

/-- Mean directional action, before specializing to the common direction. -/
noncomputable def batchMeanAction {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) : ℝ :=
  (∑ b, dirAction (X b) θ (y b) D) / (B : ℝ)

@[simp] theorem batchMeanDirection_ofLp {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (j : Fin d) :
    (batchMeanDirection X θ y).ofLp j =
      (∑ b, (ceDirection (X b) θ (y b)).ofLp j) / (B : ℝ) := rfl

/-- The mean of the own negative directions is minus the mean residual
transpose; this is a coordinate equality, not an alignment assertion. -/
theorem batchMeanDirection_eq_neg_meanResidualTranspose
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) :
    batchMeanDirection X θ y =
      WithLp.toLp 2 (fun j => -meanResidualTranspose X θ y j) := by
  apply PiLp.ext
  intro j
  rw [batchMeanDirection_ofLp]
  simp only [ceDirection_ofLp, meanResidualTranspose]
  rw [Finset.sum_neg_distrib]
  ring

/-! ## Raw-gradient minimum-norm common direction -/

/-- The raw residual-transpose gradient of one sample on the Euclidean
carrier.  Its negative is the existing `ceDirection`. -/
noncomputable def batchResidualGradient {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V) :
    EuclideanSpace ℝ (Fin d) :=
  WithLp.toLp 2 (residualTranspose X θ t)

@[simp] theorem batchResidualGradient_ofLp {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V)
    (j : Fin d) :
    (batchResidualGradient X θ t).ofLp j = residualTranspose X θ t j := rfl

/-- On a nonempty finite batch, compactness of the convex hull supplies a
minimum-norm raw-gradient convex combination. -/
theorem exists_batchGradientMinimizer {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)] :
    ∃ ω ∈ convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b)),
      ∀ c ∈ convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b)),
        ‖ω‖ ≤ ‖c‖ := by
  let C := convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b))
  have hCcompact : IsCompact C :=
    (Set.finite_range _).isCompact_convexHull ℝ
  have hCnonempty : C.Nonempty :=
    (Set.range_nonempty _).mono
      (subset_convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b)))
  obtain ⟨ω, hω, hmin⟩ := hCcompact.exists_isMinOn hCnonempty
    continuous_norm.continuousOn
  exact ⟨ω, hω, fun c hc => hmin hc⟩

/-- Totalized classical minimum-norm point of the raw-gradient convex hull.
At an empty batch there is no simplex choice and the value is zero. -/
noncomputable def batchGradientMinimizer {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : EuclideanSpace ℝ (Fin d) := by
  classical
  exact if hB : Nonempty (Fin B) then
    letI := hB
    Classical.choose (exists_batchGradientMinimizer X θ y)
  else 0

theorem batchGradientMinimizer_spec {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [hB : Nonempty (Fin B)] :
    batchGradientMinimizer X θ y ∈
        convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b)) ∧
      ∀ c ∈ convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b)),
        ‖batchGradientMinimizer X θ y‖ ≤ ‖c‖ := by
  classical
  rw [batchGradientMinimizer, dite_eq_left hB]
  exact Classical.choose_spec (exists_batchGradientMinimizer X θ y)

theorem batchGradientMinimizer_mem {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)] :
    batchGradientMinimizer X θ y ∈
      convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b)) :=
  (batchGradientMinimizer_spec X θ y).1

theorem batchGradientMinimizer_norm_le {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)]
    {c : EuclideanSpace ℝ (Fin d)}
    (hc : c ∈ convexHull ℝ
      (Set.range fun b => batchResidualGradient (X b) θ (y b))) :
    ‖batchGradientMinimizer X θ y‖ ≤ ‖c‖ :=
  (batchGradientMinimizer_spec X θ y).2 c hc

@[simp] theorem batchGradientMinimizer_empty {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 0 → V) : batchGradientMinimizer X θ y = 0 := by
  simp [batchGradientMinimizer]

/-- The actual arithmetic-mean raw gradient is a uniform convex combination
of the sample gradients. -/
theorem meanResidualTranspose_mem_convexHull {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)] :
    WithLp.toLp 2 (meanResidualTranspose X θ y) ∈
      convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b)) := by
  classical
  let b0 : Fin B := Classical.choice (inferInstance : Nonempty (Fin B))
  have hB : (B : ℝ) ≠ 0 := by
    intro h
    have hB0 : B = 0 := Nat.cast_eq_zero.mp h
    subst B
    exact Fin.elim0 b0
  have hmean :
      (∑ b, (B : ℝ)⁻¹ • batchResidualGradient (X b) θ (y b)) =
        WithLp.toLp 2 (meanResidualTranspose X θ y) := by
    apply PiLp.ext
    intro j
    simp only [WithLp.ofLp_sum, Finset.sum_apply, WithLp.ofLp_smul,
      Pi.smul_apply, smul_eq_mul, batchResidualGradient_ofLp, meanResidualTranspose]
    rw [← Finset.mul_sum, div_eq_inv_mul]
  rw [← hmean]
  apply (convex_convexHull ℝ _).sum_mem
  · intro b _hb
    exact inv_nonneg.mpr (Nat.cast_nonneg B)
  · simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    exact mul_inv_cancel₀ hB
  · intro b _hb
    exact subset_convexHull ℝ _ ⟨b, rfl⟩

theorem batchGradientMinimizer_norm_le_mean {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)] :
    ‖batchGradientMinimizer X θ y‖ ≤
      ‖WithLp.toLp 2 (meanResidualTranspose X θ y)‖ :=
  batchGradientMinimizer_norm_le X θ y (meanResidualTranspose_mem_convexHull X θ y)

/-- On a two-sample batch, the indexed raw residual gradients are exactly
the unordered pair of the two sample gradients. -/
theorem batchGradientRange_pair {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 2 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 2 → V) :
    Set.range (fun b : Fin 2 => batchResidualGradient (X b) θ (y b)) =
      {batchResidualGradient (X 0) θ (y 0),
        batchResidualGradient (X 1) θ (y 1)} := by
  apply Set.ext
  intro g
  constructor
  · rintro ⟨b, rfl⟩
    fin_cases b
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ (Set.mem_singleton _)
  · intro hg
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

/-- For two samples, the raw residual-gradient convex hull is the segment
between the two actual gradients at the current parameters. -/
theorem batchGradientHull_pair {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 2 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 2 → V) :
    convexHull ℝ (Set.range fun b : Fin 2 =>
        batchResidualGradient (X b) θ (y b)) =
      segment ℝ (batchResidualGradient (X 0) θ (y 0))
        (batchResidualGradient (X 1) θ (y 1)) := by
  rw [batchGradientRange_pair, convexHull_pair]

/-- The selected minimum-norm point on a two-sample residual-gradient hull
is exactly the closed-form segment minimum from `Hagi.Step`. -/
theorem batchGradientMinimizer_pair {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 2 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 2 → V) :
    batchGradientMinimizer X θ y =
      Hagi.Step.segmentMinNorm (batchResidualGradient (X 0) θ (y 0))
        (batchResidualGradient (X 1) θ (y 1)) := by
  apply Hagi.Step.eq_segmentMinNorm_of_mem_of_forall_norm_le
  · rw [← batchGradientHull_pair X θ y]
    exact batchGradientMinimizer_mem X θ y
  · intro p hp
    rw [← batchGradientHull_pair X θ y] at hp
    exact batchGradientMinimizer_norm_le X θ y hp

/-- Residual action is the dot product with the generating direction. -/
theorem dirAction_eq_dot {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d)) (t : V) :
    dirAction X θ t D = ∑ j, residualTranspose X θ t j * D.ofLp j := by
  simp only [dirAction, ceLogits, residualTranspose, Matrix.mulVec, dotProduct,
    Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _hj
  apply Finset.sum_congr rfl
  intro v _hv
  ring

/-- The finite-dimensional action is the Euclidean inner product with the
raw residual gradient. -/
theorem dirAction_eq_inner {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d)) (t : V) :
    dirAction X θ t D = ⟪batchResidualGradient X θ t, D⟫_ℝ := by
  rw [dirAction_eq_dot, PiLp.inner_apply]
  apply Finset.sum_congr rfl
  intro j _hj
  simp [batchResidualGradient_ofLp, RCLike.inner_apply, mul_comm]

/-- Projection variational inequality at `g0 = 0`: every sample raw
gradient has at least the minimizer's squared norm as alignment. -/
theorem batchGradientMinimizer_kkt {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (b : Fin B) :
    ‖batchGradientMinimizer X θ y‖ ^ 2 ≤
      ⟪batchResidualGradient (X b) θ (y b), batchGradientMinimizer X θ y⟫_ℝ := by
  letI : Nonempty (Fin B) := ⟨b⟩
  let C := convexHull ℝ (Set.range fun b => batchResidualGradient (X b) θ (y b))
  have hdist : ∀ c ∈ C,
      dist (batchGradientMinimizer X θ y) 0 ≤ dist c 0 := by
    intro c hc
    simpa [dist_eq_norm] using batchGradientMinimizer_norm_le X θ y hc
  have hvi := Hagi.Step.min_dist_to_vi C (convex_convexHull ℝ _) 0
    (batchGradientMinimizer X θ y) (batchGradientMinimizer_mem X θ y) hdist
    (batchResidualGradient (X b) θ (y b))
    (subset_convexHull ℝ _ ⟨b, rfl⟩)
  rw [zero_sub, inner_neg_left, inner_sub_right,
    real_inner_self_eq_norm_sq,
    real_inner_comm (batchResidualGradient (X b) θ (y b))
      (batchGradientMinimizer X θ y)] at hvi
  linarith

/-- Moving along minus the minimum-norm raw gradient gives the exact
per-sample directional action upper bound, with no mean-only step used. -/
theorem dirAction_neg_batchGradientMinimizer_le {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (b : Fin B) :
    dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y) ≤
      -‖batchGradientMinimizer X θ y‖ ^ 2 := by
  rw [dirAction_eq_inner, inner_neg_right]
  exact neg_le_neg (batchGradientMinimizer_kkt X θ y b)

/-- A nonzero minimizer can occur only on a nonempty batch. -/
theorem nonempty_fin_batch_of_minimizer_ne_zero {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y ≠ 0) : Nonempty (Fin B) := by
  classical
  by_contra hB
  apply hω
  simp [batchGradientMinimizer, hB]

/-- Strict KKT at nonzero minimizer forces every sample's exact CE range
along `-ω` to be positive. -/
theorem dirRange_neg_batchGradientMinimizer_pos {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y ≠ 0) (b : Fin B) :
    0 < dirRange (X b) (-batchGradientMinimizer X θ y) := by
  by_contra hpos
  have hR : dirRange (X b) (-batchGradientMinimizer X θ y) = 0 :=
    le_antisymm (le_of_not_gt hpos) (dirRange_nonneg _ _)
  have hzero := (dirRange_eq_zero_iff
    (X b) (-batchGradientMinimizer X θ y)).mp hR
  have hA := dirAction_neg_batchGradientMinimizer_le X θ y b
  have hA0 : dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y) = 0 := by
    simp [dirAction, hzero]
  have hn : 0 < ‖batchGradientMinimizer X θ y‖ ^ 2 :=
    sq_pos_of_pos (norm_pos_iff.mpr hω)
  rw [hA0] at hA
  linarith

/-- The common conflict-free finite window, using exact CE-range algebra.
These `eps` and `L` labels are not empirical smoothness assumptions. -/
noncomputable def batchCommonSafeWindow {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)] : ℝ :=
  Hagi.Step.safeqpEtaMaxConflictFree
    (fun _ : Fin B => ‖batchGradientMinimizer X θ y‖ ^ 2)
    (fun b => (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 /
      (4 * ‖batchGradientMinimizer X θ y‖ ^ 2))
    (batchGradientMinimizer X θ y)

theorem batchCommonSafeWindow_pos {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)]
    (hω : batchGradientMinimizer X θ y ≠ 0) : 0 < batchCommonSafeWindow X θ y := by
  unfold batchCommonSafeWindow
  apply Hagi.Step.safeqpEtaMaxConflictFree_pos
  · intro b
    exact div_pos (sq_pos_of_pos (dirRange_neg_batchGradientMinimizer_pos X θ y hω b))
      (mul_pos (by norm_num) (sq_pos_of_pos (norm_pos_iff.mpr hω)))
  · intro b
    exact sq_pos_of_pos (norm_pos_iff.mpr hω)
  · exact hω

/-- Each raw SafeQP threshold simplifies to the exact CE-range threshold. -/
theorem batchCommonSafeWindow_le_threshold {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)]
    (hω : batchGradientMinimizer X θ y ≠ 0) (b : Fin B) :
    batchCommonSafeWindow X θ y ≤
      8 * ‖batchGradientMinimizer X θ y‖ ^ 2 /
        (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 := by
  have hraw := ((Hagi.Step.le_safeqpEtaMaxConflictFree_iff
    (fun _ : Fin B => ‖batchGradientMinimizer X θ y‖ ^ 2)
    (fun b => (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 /
      (4 * ‖batchGradientMinimizer X θ y‖ ^ 2))
    (batchGradientMinimizer X θ y)).mp
      (le_refl (batchCommonSafeWindow X θ y))).2 b
  have hn : ‖batchGradientMinimizer X θ y‖ ^ 2 ≠ 0 :=
    ne_of_gt (sq_pos_of_pos (norm_pos_iff.mpr hω))
  have hR : (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 ≠ 0 :=
    ne_of_gt (sq_pos_of_pos (dirRange_neg_batchGradientMinimizer_pos X θ y hω b))
  unfold batchCommonSafeWindow
  calc
    Hagi.Step.safeqpEtaMaxConflictFree
        (fun _ : Fin B => ‖batchGradientMinimizer X θ y‖ ^ 2)
        (fun b => (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 /
          (4 * ‖batchGradientMinimizer X θ y‖ ^ 2))
        (batchGradientMinimizer X θ y) ≤
      2 * ‖batchGradientMinimizer X θ y‖ ^ 2 /
        ((dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 /
          (4 * ‖batchGradientMinimizer X θ y‖ ^ 2) *
            ‖batchGradientMinimizer X θ y‖ ^ 2) := hraw
    _ = 8 * ‖batchGradientMinimizer X θ y‖ ^ 2 /
        (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 := by
      field_simp [hn, hR]
      ring

/-- Canonical totalized common step: half the positive finite window at a
nonzero minimizer, and zero at an empty batch or zero direction. -/
noncomputable def batchCommonSafeEta {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ := by
  classical
  exact if hB : Nonempty (Fin B) then
    letI := hB
    if hω : batchGradientMinimizer X θ y = 0 then 0
    else batchCommonSafeWindow X θ y / 2
  else 0

@[simp] theorem batchCommonSafeEta_of_minimizer_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y = 0) :
    batchCommonSafeEta X θ y = 0 := by
  classical
  by_cases hB : Nonempty (Fin B)
  · simp [batchCommonSafeEta, hB, hω]
  · simp [batchCommonSafeEta, hB]

@[simp] theorem batchCommonSafeEta_empty {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 0 → V) : batchCommonSafeEta X θ y = 0 := by
  simp [batchCommonSafeEta]

theorem batchCommonSafeEta_pos_of_minimizer_ne_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y ≠ 0) :
    0 < batchCommonSafeEta X θ y := by
  classical
  letI : Nonempty (Fin B) := nonempty_fin_batch_of_minimizer_ne_zero X θ y hω
  rw [batchCommonSafeEta, dite_eq_left (inferInstance : Nonempty (Fin B)), dite_eq_right hω]
  exact half_pos (batchCommonSafeWindow_pos X θ y hω)

theorem batchCommonSafeEta_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : 0 ≤ batchCommonSafeEta X θ y := by
  by_cases hω : batchGradientMinimizer X θ y = 0
  · rw [batchCommonSafeEta_of_minimizer_eq_zero X θ y hω]
  · exact (batchCommonSafeEta_pos_of_minimizer_ne_zero X θ y hω).le

/-- Halving the window makes eta strictly smaller than every sample's
quadratic-descent threshold. -/
theorem batchCommonSafeEta_lt_threshold {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y ≠ 0) (b : Fin B) :
    batchCommonSafeEta X θ y <
      8 * ‖batchGradientMinimizer X θ y‖ ^ 2 /
        (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 := by
  classical
  letI : Nonempty (Fin B) := nonempty_fin_batch_of_minimizer_ne_zero X θ y hω
  have heta : batchCommonSafeEta X θ y = batchCommonSafeWindow X θ y / 2 := by
    rw [batchCommonSafeEta, dite_eq_left (inferInstance : Nonempty (Fin B)), dite_eq_right hω]
  rw [heta]
  have hM := batchCommonSafeWindow_pos X θ y hω
  have hle := batchCommonSafeWindow_le_threshold X θ y hω b
  have hR : 0 < (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 :=
    sq_pos_of_pos (dirRange_neg_batchGradientMinimizer_pos X θ y hω b)
  have hth : 0 < 8 * ‖batchGradientMinimizer X θ y‖ ^ 2 /
      (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 :=
    div_pos (mul_pos (by norm_num) (sq_pos_of_pos (norm_pos_iff.mpr hω))) hR
  linarith

/-- Parameter update in the common negative minimum-norm direction. -/
noncomputable def batchCommonNextParameters {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : EuclideanSpace ℝ (Fin d) :=
  alongNext θ (-batchGradientMinimizer X θ y) (batchCommonSafeEta X θ y)

@[simp] theorem batchCommonNextParameters_of_minimizer_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y = 0) :
    batchCommonNextParameters X θ y = θ := by
  rw [batchCommonNextParameters, batchCommonSafeEta_of_minimizer_eq_zero X θ y hω,
    alongNext_zero]

@[simp] theorem batchCommonNextParameters_empty {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 0 → V) : batchCommonNextParameters X θ y = θ := by
  rw [batchCommonNextParameters, batchCommonSafeEta_empty, alongNext_zero]

/-- The half-window gives strict actual CE descent on every sample. -/
theorem ceOneHot_batchCommonNextParameters_lt {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y ≠ 0) (b : Fin B) :
    Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchCommonNextParameters X θ y)) <
      Hagi.ceOneHot (y b) (ceLogits (X b) θ) := by
  letI : Nonempty V := ⟨y b⟩
  have heta := batchCommonSafeEta_pos_of_minimizer_ne_zero X θ y hω
  have hA := dirAction_neg_batchGradientMinimizer_le X θ y b
  have hR := dirRange_neg_batchGradientMinimizer_pos X θ y hω b
  have hwindow := batchCommonSafeEta_lt_threshold X θ y hω b
  have hscaled := (lt_div_iff₀ (sq_pos_of_pos hR)).mp hwindow
  have hlinear : batchCommonSafeEta X θ y *
      dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y) ≤
      -batchCommonSafeEta X θ y * ‖batchGradientMinimizer X θ y‖ ^ 2 := by
    calc
      batchCommonSafeEta X θ y *
          dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y) ≤
        batchCommonSafeEta X θ y * (-‖batchGradientMinimizer X θ y‖ ^ 2) :=
          mul_le_mul_of_nonneg_left hA heta.le
      _ = -batchCommonSafeEta X θ y * ‖batchGradientMinimizer X θ y‖ ^ 2 := by ring
  have hquadratic :
      (batchCommonSafeEta X θ y *
          dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 / 8 <
        batchCommonSafeEta X θ y * ‖batchGradientMinimizer X θ y‖ ^ 2 := by
    have hmul := mul_lt_mul_of_pos_left hscaled heta
    nlinarith [hmul]
  calc
    Hagi.ceOneHot (y b) (ceLogits (X b) (batchCommonNextParameters X θ y)) ≤
      Hagi.ceOneHot (y b) (ceLogits (X b) θ) + batchCommonSafeEta X θ y *
        dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y) +
        (batchCommonSafeEta X θ y *
          dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 / 8 := by
      rw [batchCommonNextParameters]
      exact ceOneHot_alongNext_le (X b) θ (-batchGradientMinimizer X θ y)
        (y b) heta.le
    _ ≤ Hagi.ceOneHot (y b) (ceLogits (X b) θ) -
        batchCommonSafeEta X θ y * ‖batchGradientMinimizer X θ y‖ ^ 2 +
        (batchCommonSafeEta X θ y *
          dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 / 8 := by
      linarith
    _ < Hagi.ceOneHot (y b) (ceLogits (X b) θ) := by
      linarith

/-- Every sample is nonincreasing at the selected common update; the zero
direction branch is actual preservation rather than vacuous strict progress. -/
theorem ceOneHot_batchCommonNextParameters_le {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (b : Fin B) :
    Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchCommonNextParameters X θ y)) ≤
      Hagi.ceOneHot (y b) (ceLogits (X b) θ) := by
  by_cases hω : batchGradientMinimizer X θ y = 0
  · rw [batchCommonNextParameters_of_minimizer_eq_zero X θ y hω]
  · exact (ceOneHot_batchCommonNextParameters_lt X θ y hω b).le

@[simp] theorem ceOneHot_batchCommonNextParameters_of_minimizer_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y = 0) (b : Fin B) :
    Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchCommonNextParameters X θ y)) =
      Hagi.ceOneHot (y b) (ceLogits (X b) θ) := by
  rw [batchCommonNextParameters_of_minimizer_eq_zero X θ y hω]

@[simp] theorem batchLoss_batchCommonNextParameters_empty
    {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 0 → V) : batchLoss X (batchCommonNextParameters X θ y) y = batchLoss X θ y := by
  rw [batchCommonNextParameters_empty]

/-- A negative directional action forces a positive exact CE logit range. -/
theorem dirRange_pos_of_dirAction_neg {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V)
    (D : EuclideanSpace ℝ (Fin d)) (hA : dirAction X θ t D < 0) :
    0 < dirRange X D := by
  by_contra hpos
  have hR : dirRange X D = 0 :=
    le_antisymm (le_of_not_gt hpos) (dirRange_nonneg _ _)
  have hzero := (dirRange_eq_zero_iff X D).mp hR
  have hA0 : dirAction X θ t D = 0 := by
    simp [dirAction, hzero]
  linarith

/-- A certified negative action at every sample also rules out the zero
parameter direction, without any convex-hull or minimizer hypothesis. -/
theorem batchDirection_ne_zero_of_forall_dirAction_neg
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)]
    (hneg : ∀ b, dirAction (X b) θ (y b) D < 0) : D ≠ 0 := by
  let b0 : Fin B := Classical.choice (inferInstance : Nonempty (Fin B))
  intro hD
  have hA := hneg b0
  rw [dirAction_eq_inner, hD, inner_zero_right] at hA
  exact (lt_irrefl 0) hA

/-- The conflict-free window for an arbitrary direction, using each exact
negative CE directional action as its margin.  The curvature denominator is
`‖D‖²`, so the generic SafeQP normalization has the exact CE threshold. -/
noncomputable def batchDirectionSafeWindow {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)] : ℝ :=
  Hagi.Step.safeqpEtaMaxConflictFree
    (fun b => -dirAction (X b) θ (y b) D)
    (fun b => (dirRange (X b) D) ^ 2 / (4 * ‖D‖ ^ 2))
    D

/-- The arbitrary-direction window is positive under the pointwise negative
CE derivative certificate. -/
theorem batchDirectionSafeWindow_pos {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)]
    (hneg : ∀ b, dirAction (X b) θ (y b) D < 0) :
    0 < batchDirectionSafeWindow X θ y D := by
  have hD := batchDirection_ne_zero_of_forall_dirAction_neg X θ y D hneg
  unfold batchDirectionSafeWindow
  apply Hagi.Step.safeqpEtaMaxConflictFree_pos
  · intro b
    exact div_pos (sq_pos_of_pos (dirRange_pos_of_dirAction_neg
      (X b) θ (y b) D (hneg b)))
      (mul_pos (by norm_num) (sq_pos_of_pos (norm_pos_iff.mpr hD)))
  · intro b
    exact neg_pos.mpr (hneg b)
  · exact hD

/-- Each raw SafeQP threshold is exactly the arbitrary-direction CE
majorizer threshold; the two norm-square factors cancel. -/
theorem batchDirectionSafeWindow_le_threshold {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)]
    (hneg : ∀ b, dirAction (X b) θ (y b) D < 0) (b : Fin B) :
    batchDirectionSafeWindow X θ y D ≤
      8 * (-dirAction (X b) θ (y b) D) / (dirRange (X b) D) ^ 2 := by
  have hraw := ((Hagi.Step.le_safeqpEtaMaxConflictFree_iff
    (fun b => -dirAction (X b) θ (y b) D)
    (fun b => (dirRange (X b) D) ^ 2 / (4 * ‖D‖ ^ 2)) D).mp
      (le_refl (batchDirectionSafeWindow X θ y D))).2 b
  have hD := batchDirection_ne_zero_of_forall_dirAction_neg X θ y D hneg
  have hN : ‖D‖ ^ 2 ≠ 0 :=
    ne_of_gt (sq_pos_of_pos (norm_pos_iff.mpr hD))
  have hR : (dirRange (X b) D) ^ 2 ≠ 0 :=
    ne_of_gt (sq_pos_of_pos
      (dirRange_pos_of_dirAction_neg (X b) θ (y b) D (hneg b)))
  unfold batchDirectionSafeWindow
  calc
    Hagi.Step.safeqpEtaMaxConflictFree
        (fun b => -dirAction (X b) θ (y b) D)
        (fun b => (dirRange (X b) D) ^ 2 / (4 * ‖D‖ ^ 2)) D ≤
      2 * (-dirAction (X b) θ (y b) D) /
        ((dirRange (X b) D) ^ 2 / (4 * ‖D‖ ^ 2) * ‖D‖ ^ 2) := hraw
    _ = 8 * (-dirAction (X b) θ (y b) D) / (dirRange (X b) D) ^ 2 := by
      field_simp [hN, hR]
      ring

/-- Half the certified arbitrary-direction window.  The totalized value is
zero unless the batch is nonempty and every CE directional derivative is
strictly negative. -/
noncomputable def batchDirectionSafeEta {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) : ℝ := by
  classical
  exact if hcert : Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0 then
    letI := hcert.1
    batchDirectionSafeWindow X θ y D / 2
  else 0

/-- On the certified branch, the selected step is exactly half the window. -/
theorem batchDirectionSafeEta_of_neg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)]
    (hneg : ∀ b, dirAction (X b) θ (y b) D < 0) :
    batchDirectionSafeEta X θ y D = batchDirectionSafeWindow X θ y D / 2 := by
  classical
  have hcert : Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0 := ⟨inferInstance, hneg⟩
  rw [batchDirectionSafeEta, dite_eq_left hcert]

/-- Positivity of the totalized step is exactly the full certificate.  In
particular, an empty batch cannot make the universal condition vacuously
produce a positive step. -/
theorem batchDirectionSafeEta_pos_iff {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) :
    0 < batchDirectionSafeEta X θ y D ↔
      Nonempty (Fin B) ∧ ∀ b, dirAction (X b) θ (y b) D < 0 := by
  classical
  constructor
  · intro heta
    by_contra hcert
    have hzero : batchDirectionSafeEta X θ y D = 0 := by
      simp [batchDirectionSafeEta, hcert]
    linarith
  · intro hcert
    let _ : Nonempty (Fin B) := hcert.1
    rw [batchDirectionSafeEta_of_neg X θ y D hcert.2]
    exact half_pos (batchDirectionSafeWindow_pos X θ y D hcert.2)

/-- Failure of either conjunct selects the exact zero step. -/
theorem batchDirectionSafeEta_eq_zero {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d))
    (hcert : ¬ (Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0)) :
    batchDirectionSafeEta X θ y D = 0 := by
  classical
  simp [batchDirectionSafeEta, hcert]

theorem batchDirectionSafeEta_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) :
    0 ≤ batchDirectionSafeEta X θ y D := by
  by_cases hcert : Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0
  · exact ((batchDirectionSafeEta_pos_iff X θ y D).2 hcert).le
  · rw [batchDirectionSafeEta_eq_zero X θ y D hcert]

@[simp] theorem batchDirectionSafeEta_empty {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 0 → V) (D : EuclideanSpace ℝ (Fin d)) :
    batchDirectionSafeEta X θ y D = 0 := by
  simp [batchDirectionSafeEta]

/-- Half the finite window is strictly below every sample's exact CE
quadratic-descent threshold. -/
theorem batchDirectionSafeEta_lt_threshold {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)]
    (hneg : ∀ b, dirAction (X b) θ (y b) D < 0) (b : Fin B) :
    batchDirectionSafeEta X θ y D <
      8 * (-dirAction (X b) θ (y b) D) / (dirRange (X b) D) ^ 2 := by
  rw [batchDirectionSafeEta_of_neg X θ y D hneg]
  have hwindow := batchDirectionSafeWindow_pos X θ y D hneg
  have hle := batchDirectionSafeWindow_le_threshold X θ y D hneg b
  have hR : 0 < (dirRange (X b) D) ^ 2 :=
    sq_pos_of_pos (dirRange_pos_of_dirAction_neg (X b) θ (y b) D (hneg b))
  have hthreshold : 0 < 8 * (-dirAction (X b) θ (y b) D) /
      (dirRange (X b) D) ^ 2 :=
    div_pos (mul_pos (by norm_num) (neg_pos.mpr (hneg b))) hR
  linarith

/-- Parameter update along an arbitrary direction at its totalized certified
step. -/
noncomputable def batchDirectionNextParameters {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) :
    EuclideanSpace ℝ (Fin d) :=
  alongNext θ D (batchDirectionSafeEta X θ y D)

/-- Without the complete certificate the direction update preserves the
actual model parameters; this says nothing about other training-state fields. -/
theorem batchDirectionNextParameters_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d))
    (hcert : ¬ (Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0)) :
    batchDirectionNextParameters X θ y D = θ := by
  rw [batchDirectionNextParameters,
    batchDirectionSafeEta_eq_zero X θ y D hcert, alongNext_zero]

@[simp] theorem batchDirectionNextParameters_empty
    {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 0 → V) (D : EuclideanSpace ℝ (Fin d)) :
    batchDirectionNextParameters X θ y D = θ := by
  rw [batchDirectionNextParameters, batchDirectionSafeEta_empty, alongNext_zero]

/-- The exact local per-sample CE margin supplied by the half-window step.
This is a mathematical lower bound on the guaranteed drop, not a physical
cost, an empirical rate, or a trajectory-wide discount. -/
noncomputable def batchDirectionMargin {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) (b : Fin B) : ℝ :=
  batchDirectionSafeEta X θ y D * (-dirAction (X b) θ (y b) D) / 2

/-- The local margin is nonnegative even without a complete certificate:
the totalized step is zero on that branch. -/
theorem batchDirectionMargin_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) (b : Fin B) :
    0 ≤ batchDirectionMargin X θ y D b := by
  by_cases hcert : Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0
  · exact div_nonneg
      (mul_nonneg (batchDirectionSafeEta_nonneg X θ y D)
        (neg_nonneg.mpr (hcert.2 b).le)) (by norm_num)
  · simp [batchDirectionMargin, batchDirectionSafeEta_eq_zero X θ y D hcert]

/-- The full negative-derivative certificate makes each local margin
strictly positive. -/
theorem batchDirectionMargin_pos_of_neg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)]
    (hneg : ∀ b, dirAction (X b) θ (y b) D < 0) (b : Fin B) :
    0 < batchDirectionMargin X θ y D b := by
  have heta := (batchDirectionSafeEta_pos_iff X θ y D).2 ⟨inferInstance, hneg⟩
  exact div_pos (mul_pos heta (neg_pos.mpr (hneg b))) (by norm_num)

/-- Every arbitrary-direction update decreases each sample's actual CE by at
least its exact local margin.  Without the full certificate both the step and
the margin vanish, so no conditional premise is needed in the statement. -/
theorem ceOneHot_batchDirectionNextParameters_le_margin
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) (b : Fin B) :
    Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchDirectionNextParameters X θ y D)) ≤
      Hagi.ceOneHot (y b) (ceLogits (X b) θ) -
        batchDirectionMargin X θ y D b := by
  by_cases hcert : Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0
  · let _ : Nonempty (Fin B) := hcert.1
    let _ : Nonempty V := ⟨y b⟩
    have heta := (batchDirectionSafeEta_pos_iff X θ y D).2 hcert
    have hR := dirRange_pos_of_dirAction_neg (X b) θ (y b) D (hcert.2 b)
    have hwindow := batchDirectionSafeWindow_le_threshold X θ y D hcert.2 b
    have heta_of_neg := batchDirectionSafeEta_of_neg X θ y D hcert.2
    have heta_le : batchDirectionSafeEta X θ y D ≤
        4 * (-dirAction (X b) θ (y b) D) / (dirRange (X b) D) ^ 2 := by
      rw [heta_of_neg]
      calc
        batchDirectionSafeWindow X θ y D / 2 ≤
            (8 * (-dirAction (X b) θ (y b) D) / (dirRange (X b) D) ^ 2) / 2 :=
          div_le_div_of_nonneg_right hwindow (by norm_num)
        _ = 4 * (-dirAction (X b) θ (y b) D) / (dirRange (X b) D) ^ 2 := by
          ring
    have hscaled : batchDirectionSafeEta X θ y D * (dirRange (X b) D) ^ 2 ≤
        4 * (-dirAction (X b) θ (y b) D) :=
      (le_div_iff₀ (sq_pos_of_pos hR)).mp heta_le
    have hmul := mul_le_mul_of_nonneg_left hscaled heta.le
    have hquadratic :
        (batchDirectionSafeEta X θ y D * dirRange (X b) D) ^ 2 / 8 ≤
          batchDirectionSafeEta X θ y D *
            (-dirAction (X b) θ (y b) D) / 2 := by
      nlinarith [hmul]
    calc
      Hagi.ceOneHot (y b)
          (ceLogits (X b) (batchDirectionNextParameters X θ y D)) ≤
        Hagi.ceOneHot (y b) (ceLogits (X b) θ) +
          batchDirectionSafeEta X θ y D * dirAction (X b) θ (y b) D +
          (batchDirectionSafeEta X θ y D * dirRange (X b) D) ^ 2 / 8 := by
        rw [batchDirectionNextParameters]
        exact ceOneHot_alongNext_le (X b) θ D (y b) heta.le
      _ ≤ Hagi.ceOneHot (y b) (ceLogits (X b) θ) -
          batchDirectionMargin X θ y D b := by
        unfold batchDirectionMargin
        nlinarith [hquadratic]
  · rw [batchDirectionNextParameters_eq_zero X θ y D hcert]
    simp [batchDirectionMargin, batchDirectionSafeEta_eq_zero X θ y D hcert]

/-- The arithmetic-mean loss decreases by at least the arithmetic mean of the
same exact local margins.  Lean's zero-denominator convention handles the
empty batch without introducing a nonzero-batch premise. -/
theorem batchLoss_batchDirectionNextParameters_le_margin_sum
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) :
    batchLoss X (batchDirectionNextParameters X θ y D) y ≤
      batchLoss X θ y - (∑ b, batchDirectionMargin X θ y D b) / (B : ℝ) := by
  have hsum : (∑ b, Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchDirectionNextParameters X θ y D))) ≤
      ∑ b, (Hagi.ceOneHot (y b) (ceLogits (X b) θ) -
        batchDirectionMargin X θ y D b) :=
    Finset.sum_le_sum (fun b _hb =>
      ceOneHot_batchDirectionNextParameters_le_margin X θ y D b)
  have hdiv := div_le_div_of_nonneg_right hsum (Nat.cast_nonneg B)
  unfold batchLoss Hagi.Probability.FiniteFamilyConfidence.empiricalMean
  calc
    (∑ b, Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchDirectionNextParameters X θ y D))) / (B : ℝ) ≤
      (∑ b, (Hagi.ceOneHot (y b) (ceLogits (X b) θ) -
        batchDirectionMargin X θ y D b)) / (B : ℝ) := hdiv
    _ = (∑ b, Hagi.ceOneHot (y b) (ceLogits (X b) θ)) / (B : ℝ) -
        (∑ b, batchDirectionMargin X θ y D b) / (B : ℝ) := by
      rw [Finset.sum_sub_distrib, sub_div]

/-- The exact half-window produces strict actual CE descent on every sample
under only the negative directional-derivative certificate. -/
theorem ceOneHot_batchDirectionNextParameters_lt
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)]
    (hneg : ∀ b, dirAction (X b) θ (y b) D < 0) (b : Fin B) :
    Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchDirectionNextParameters X θ y D)) <
      Hagi.ceOneHot (y b) (ceLogits (X b) θ) := by
  have hbound := ceOneHot_batchDirectionNextParameters_le_margin X θ y D b
  have hmargin := batchDirectionMargin_pos_of_neg X θ y D hneg b
  linarith

/-- Every sample is nonincreasing, including the exact zero-step branch when
any sample lacks a negative directional derivative. -/
theorem ceOneHot_batchDirectionNextParameters_le
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) (b : Fin B) :
    Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchDirectionNextParameters X θ y D)) ≤
      Hagi.ceOneHot (y b) (ceLogits (X b) θ) := by
  by_cases hcert : Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0
  · let _ : Nonempty (Fin B) := hcert.1
    exact (ceOneHot_batchDirectionNextParameters_lt X θ y D hcert.2 b).le
  · rw [batchDirectionNextParameters_eq_zero X θ y D hcert]

@[simp] theorem ceOneHot_batchDirectionNextParameters_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d))
    (hcert : ¬ (Nonempty (Fin B) ∧
      ∀ b, dirAction (X b) θ (y b) D < 0)) (b : Fin B) :
    Hagi.ceOneHot (y b)
        (ceLogits (X b) (batchDirectionNextParameters X θ y D)) =
      Hagi.ceOneHot (y b) (ceLogits (X b) θ) := by
  rw [batchDirectionNextParameters_eq_zero X θ y D hcert]

@[simp] theorem batchLoss_batchDirectionNextParameters_empty
    {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin 0 → V) (D : EuclideanSpace ℝ (Fin d)) :
    batchLoss X (batchDirectionNextParameters X θ y D) y = batchLoss X θ y := by
  rw [batchDirectionNextParameters_empty]

/-- Strict component descent and the inhabited finite denominator give
strict arithmetic-mean CE descent on the supplied batch. -/
theorem batchLoss_batchDirectionNextParameters_lt
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) [Nonempty (Fin B)]
    (hneg : ∀ b, dirAction (X b) θ (y b) D < 0) :
    batchLoss X (batchDirectionNextParameters X θ y D) y < batchLoss X θ y := by
  obtain ⟨b0⟩ := (inferInstance : Nonempty (Fin B))
  have hB : 0 < B := by
    by_contra h
    have hB0 : B = 0 := Nat.eq_zero_of_not_pos h
    subst B
    exact Fin.elim0 b0
  have hsum : 0 < ∑ b, batchDirectionMargin X θ y D b :=
    Finset.sum_pos (fun b _hb => batchDirectionMargin_pos_of_neg X θ y D hneg b)
      Finset.univ_nonempty
  have hmean : 0 < (∑ b, batchDirectionMargin X θ y D b) / (B : ℝ) :=
    div_pos hsum (Nat.cast_pos.mpr hB)
  have hbound := batchLoss_batchDirectionNextParameters_le_margin_sum X θ y D
  linarith

/-- At a nonzero exact minimum-norm raw gradient, KKT makes every actual
CE directional derivative along `-ω` strictly negative. -/
theorem dirAction_neg_batchGradientMinimizer_lt
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y ≠ 0) (b : Fin B) :
    dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y) < 0 := by
  have hA := dirAction_neg_batchGradientMinimizer_le X θ y b
  have hN : 0 < ‖batchGradientMinimizer X θ y‖ ^ 2 :=
    sq_pos_of_pos (norm_pos_iff.mpr hω)
  linarith

/-- The old exact minimizer supplies the complete arbitrary-direction
certificate, including genuine batch nonemptiness. -/
theorem neg_batchGradientMinimizer_descent_certificate
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hω : batchGradientMinimizer X θ y ≠ 0) :
    Nonempty (Fin B) ∧ ∀ b,
      dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y) < 0 :=
  ⟨nonempty_fin_batch_of_minimizer_ne_zero X θ y hω,
    dirAction_neg_batchGradientMinimizer_lt X θ y hω⟩

/-- The conservative old window is no larger than the certificate-aware
window along `-ω`; their curvature families coincide after `norm_neg`. -/
theorem batchCommonSafeWindow_le_batchDirectionSafeWindow_neg_minimizer
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) [Nonempty (Fin B)]
    (hω : batchGradientMinimizer X θ y ≠ 0) :
    batchCommonSafeWindow X θ y ≤
      batchDirectionSafeWindow X θ y (-batchGradientMinimizer X θ y) := by
  have hNpos : 0 < ‖batchGradientMinimizer X θ y‖ ^ 2 :=
    sq_pos_of_pos (norm_pos_iff.mpr hω)
  have hN : ‖batchGradientMinimizer X θ y‖ ^ 2 ≠ 0 := ne_of_gt hNpos
  have hone : batchCommonSafeWindow X θ y ≤ 1 := by
    unfold batchCommonSafeWindow Hagi.Step.safeqpEtaMaxConflictFree
    exact min_le_left _ _
  unfold batchDirectionSafeWindow
  apply (Hagi.Step.le_safeqpEtaMaxConflictFree_iff _ _ _).2
  refine ⟨hone, ?_⟩
  intro b
  have hold := ((Hagi.Step.le_safeqpEtaMaxConflictFree_iff
    (fun _ : Fin B => ‖batchGradientMinimizer X θ y‖ ^ 2)
    (fun b => (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 /
      (4 * ‖batchGradientMinimizer X θ y‖ ^ 2))
    (batchGradientMinimizer X θ y)).mp
      (le_refl (batchCommonSafeWindow X θ y))).2 b
  have heps : ‖batchGradientMinimizer X θ y‖ ^ 2 ≤
      -dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y) := by
    have hA := dirAction_neg_batchGradientMinimizer_le X θ y b
    linarith
  have hR : (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 ≠ 0 :=
    ne_of_gt (sq_pos_of_pos
      (dirRange_neg_batchGradientMinimizer_pos X θ y hω b))
  calc
    batchCommonSafeWindow X θ y ≤
      2 * ‖batchGradientMinimizer X θ y‖ ^ 2 /
        ((dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 /
          (4 * ‖batchGradientMinimizer X θ y‖ ^ 2) *
            ‖batchGradientMinimizer X θ y‖ ^ 2) := hold
    _ = 8 * ‖batchGradientMinimizer X θ y‖ ^ 2 /
        (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 := by
      field_simp [hN, hR]
      ring
    _ ≤ 8 * (-dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y)) /
        (dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 :=
      div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_left heps (by norm_num)) (sq_nonneg _)
    _ = 2 * (-dirAction (X b) θ (y b) (-batchGradientMinimizer X θ y)) /
        ((dirRange (X b) (-batchGradientMinimizer X θ y)) ^ 2 /
          (4 * ‖-batchGradientMinimizer X θ y‖ ^ 2) *
            ‖-batchGradientMinimizer X θ y‖ ^ 2) := by
      rw [norm_neg]
      field_simp [hN, hR]
      ring

/-- The old selected step is conservatively no larger than the new step for
every old totalized minimizer.  This is an inequality, not eta equality or
a comparison of their actual CE values. -/
theorem batchCommonSafeEta_le_batchDirectionSafeEta_neg_minimizer
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) :
    batchCommonSafeEta X θ y ≤
      batchDirectionSafeEta X θ y (-batchGradientMinimizer X θ y) := by
  classical
  by_cases hω : batchGradientMinimizer X θ y = 0
  · rw [batchCommonSafeEta_of_minimizer_eq_zero X θ y hω]
    exact batchDirectionSafeEta_nonneg X θ y _
  · let _ : Nonempty (Fin B) := nonempty_fin_batch_of_minimizer_ne_zero X θ y hω
    have hneg := dirAction_neg_batchGradientMinimizer_lt X θ y hω
    rw [batchCommonSafeEta, dite_eq_left (inferInstance : Nonempty (Fin B)),
      dite_eq_right hω, batchDirectionSafeEta_of_neg X θ y _ hneg]
    exact div_le_div_of_nonneg_right
      (batchCommonSafeWindow_le_batchDirectionSafeWindow_neg_minimizer
        X θ y hω) (by norm_num)

/-- Averaging the exact actions on the common direction gives minus its
alignment.  At `B = 0` both sides are the algebra convention zero. -/
theorem batchMeanAction_common {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) :
    batchMeanAction X θ y (batchMeanDirection X θ y) =
      -batchAlignment X θ y := by
  classical
  by_cases hB : B = 0
  · subst B
    simp [batchMeanAction, batchAlignment, meanResidualTranspose]
  have hBreal : (B : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hB
  have hdir_at (b : Fin B) :
      dirAction (X b) θ (y b) (batchMeanDirection X θ y) =
        -∑ j, residualTranspose (X b) θ (y b) j *
          meanResidualTranspose X θ y j := by
    rw [dirAction_eq_dot, batchMeanDirection_eq_neg_meanResidualTranspose]
    simp only [meanResidualTranspose]
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro j _hj
    ring
  have hsum : (∑ b, dirAction (X b) θ (y b) (batchMeanDirection X θ y)) =
      -∑ j, (∑ b, residualTranspose (X b) θ (y b) j) *
        meanResidualTranspose X θ y j := by
    rw [Finset.sum_congr rfl (fun b _hb => hdir_at b), Finset.sum_neg_distrib,
      Finset.sum_comm]
    congr 1
    apply Finset.sum_congr rfl
    intro j _hj
    rw [Finset.sum_mul]
  have hcoord (j : Fin d) :
      (∑ b, residualTranspose (X b) θ (y b) j) =
        (B : ℝ) * meanResidualTranspose X θ y j := by
    simp only [meanResidualTranspose]
    field_simp
  have havg :
      (∑ j, (∑ b, residualTranspose (X b) θ (y b) j) *
        meanResidualTranspose X θ y j) / (B : ℝ) =
      ∑ j, (meanResidualTranspose X θ y j) ^ 2 := by
    rw [Finset.sum_div]
    apply Finset.sum_congr rfl
    intro j _hj
    rw [hcoord j]
    field_simp
  unfold batchMeanAction batchAlignment
  rw [hsum, neg_div, havg]

/-- Both scalar batch coefficients are nonnegative. -/
theorem batchAlignment_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : 0 ≤ batchAlignment X θ y := by
  unfold batchAlignment
  positivity

theorem batchRangeSquare_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : 0 ≤ batchRangeSquare X θ y := by
  unfold batchRangeSquare
  positivity

/-- Positive range-square belongs to the genuinely nonempty-batch class. -/
theorem batch_pos_of_rangeSquare_pos
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : 0 < batchRangeSquare X θ y) : 0 < B := by
  apply Nat.pos_of_ne_zero
  intro hB
  subst B
  simp [batchRangeSquare] at hR

/-- Zero mean alignment collapses the common direction itself to zero. -/
theorem batchMeanDirection_eq_zero_of_alignment_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hA : batchAlignment X θ y = 0) :
    batchMeanDirection X θ y = 0 := by
  have hm : ∀ j ∈ (Finset.univ : Finset (Fin d)),
      meanResidualTranspose X θ y j = 0 := by
    apply (Finset.sum_sq_eq_zero_iff Finset.univ
      (meanResidualTranspose X θ y)).mp
    simpa [batchAlignment] using hA
  rw [batchMeanDirection_eq_neg_meanResidualTranspose]
  apply PiLp.ext
  intro j
  simp [hm j (Finset.mem_univ j)]

/-- Positive mean common-direction range-square forces positive alignment by
forcing the common direction to be nonzero; positivity is not an assumption. -/
theorem batchAlignment_pos_of_rangeSquare_pos
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : 0 < batchRangeSquare X θ y) :
    0 < batchAlignment X θ y := by
  apply lt_of_le_of_ne (batchAlignment_nonneg X θ y)
  intro hne
  have hA : batchAlignment X θ y = 0 := hne.symm
  have hD := batchMeanDirection_eq_zero_of_alignment_eq_zero X θ y hA
  have hR0 : batchRangeSquare X θ y = 0 := by
    simp [batchRangeSquare, dirRange, ceLogits, hD, Matrix.mulVec, dotProduct]
  exact (ne_of_gt hR) hR0

/-- Safe minimizer of the common-direction averaged quadratic majorizer. -/
noncomputable def batchSafeStep {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ :=
  if batchRangeSquare X θ y = 0 then 0
  else 4 * batchAlignment X θ y / batchRangeSquare X θ y

/-- Averaged majorizer for one common step. -/
noncomputable def batchMajorizer {V : Type} [Fintype V] [Nonempty V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (eta : ℝ) : ℝ :=
  batchLoss X θ y - eta * batchAlignment X θ y
    + eta ^ 2 * batchRangeSquare X θ y / 8

/-- The actual parameter update shared by every sample. -/
noncomputable def batchNextParameters {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : EuclideanSpace ℝ (Fin d) :=
  alongNext θ (batchMeanDirection X θ y) (batchSafeStep X θ y)

/-- Average the general individual bounds, all evaluated along the same common
direction.  No universal per-example descent is asserted. -/
theorem batchLoss_alongNext_le_batchMajorizer
    {V : Type} [Fintype V] [Nonempty V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) {eta : ℝ} (heta : 0 ≤ eta) :
    batchLoss X (alongNext θ (batchMeanDirection X θ y) eta) y ≤
      batchMajorizer X θ y eta := by
  let D := batchMeanDirection X θ y
  have hsum : (∑ b, Hagi.ceOneHot (y b)
        (ceLogits (X b) (alongNext θ D eta))) ≤
      ∑ b, (Hagi.ceOneHot (y b) (ceLogits (X b) θ)
        + eta * dirAction (X b) θ (y b) D
        + (eta * dirRange (X b) D) ^ 2 / 8) := by
    exact Finset.sum_le_sum (fun b _hb =>
      ceOneHot_alongNext_le (X b) θ D (y b) heta)
  have hdiv := div_le_div_of_nonneg_right hsum (Nat.cast_nonneg B)
  have hsumAction :
      (∑ b, eta * dirAction (X b) θ (y b) D) =
        eta * ∑ b, dirAction (X b) θ (y b) D := by
    rw [Finset.mul_sum]
  have hsumRange :
      (∑ b, (eta * dirRange (X b) D) ^ 2 / 8) =
        eta ^ 2 * (∑ b, (dirRange (X b) D) ^ 2) / 8 := by
    calc
      (∑ b, (eta * dirRange (X b) D) ^ 2 / 8) =
          ∑ b, eta ^ 2 * ((dirRange (X b) D) ^ 2 / 8) := by
        apply Finset.sum_congr rfl
        intro b _hb
        ring
      _ = eta ^ 2 * ∑ b, (dirRange (X b) D) ^ 2 / 8 := by
        rw [Finset.mul_sum]
      _ = eta ^ 2 * ((∑ b, (dirRange (X b) D) ^ 2) / 8) := by
        rw [Finset.sum_div]
      _ = eta ^ 2 * (∑ b, (dirRange (X b) D) ^ 2) / 8 := by ring
  simp only [Finset.sum_add_distrib, hsumAction, hsumRange] at hdiv
  have hmean := batchMeanAction_common X θ y
  unfold batchMeanAction at hmean
  dsimp [D] at hdiv hmean
  unfold batchMajorizer batchLoss batchRangeSquare
  unfold Hagi.Probability.FiniteFamilyConfidence.empiricalMean
  calc
    (∑ b, Hagi.ceOneHot (y b)
        (ceLogits (X b) (alongNext θ (batchMeanDirection X θ y) eta))) /
        (B : ℝ) ≤
      (∑ b, Hagi.ceOneHot (y b) (ceLogits (X b) θ)
        + eta * (∑ b, dirAction (X b) θ (y b) (batchMeanDirection X θ y))
        + eta ^ 2 * (∑ b, (dirRange (X b) (batchMeanDirection X θ y)) ^ 2) / 8) /
        (B : ℝ) := hdiv
    _ = (∑ b, Hagi.ceOneHot (y b) (ceLogits (X b) θ)) / (B : ℝ)
        - eta * batchAlignment X θ y
        + eta ^ 2 *
          ((∑ b, (dirRange (X b) (batchMeanDirection X θ y)) ^ 2) / (B : ℝ)) / 8 := by
      linear_combination eta * hmean


/-- Positive range-square makes the selected common step positive. -/
theorem batchSafeStep_pos_of_rangeSquare_pos
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : 0 < batchRangeSquare X θ y) :
    0 < batchSafeStep X θ y := by
  have hA := batchAlignment_pos_of_rangeSquare_pos X θ y hR
  rw [batchSafeStep, ite_eq_right (ne_of_gt hR)]
  exact div_pos (by positivity) hR

/-- The zero-range branch and all positive-range branches are nonnegative. -/
theorem batchSafeStep_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : 0 ≤ batchSafeStep X θ y := by
  by_cases hR : batchRangeSquare X θ y = 0
  · simp [batchSafeStep, hR]
  · have hRpos : 0 < batchRangeSquare X θ y :=
      lt_of_le_of_ne (batchRangeSquare_nonneg X θ y) (Ne.symm hR)
    exact (batchSafeStep_pos_of_rangeSquare_pos X θ y hRpos).le

/-- Exact minimizer residual for the averaged majorizer. -/
theorem batchMajorizer_safeStep_eq {V : Type} [Fintype V] [Nonempty V]
    {B d : ℕ} (X : Fin B → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin B → V)
    (hR : 0 < batchRangeSquare X θ y) :
    batchMajorizer X θ y (batchSafeStep X θ y) =
      batchLoss X θ y
        - 2 * (batchAlignment X θ y) ^ 2 / batchRangeSquare X θ y := by
  simp only [batchMajorizer, batchSafeStep, ite_eq_right (ne_of_gt hR)]
  field_simp
  ring

/-- The common safe step minimizes the averaged majorizer over every real eta. -/
theorem batchMajorizer_safeStep_le {V : Type} [Fintype V] [Nonempty V]
    {B d : ℕ} (X : Fin B → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin B → V)
    (hR : 0 < batchRangeSquare X θ y) (eta : ℝ) :
    batchMajorizer X θ y (batchSafeStep X θ y) ≤
      batchMajorizer X θ y eta := by
  have hne : batchRangeSquare X θ y ≠ 0 := ne_of_gt hR
  have hdiff : batchMajorizer X θ y eta
      - batchMajorizer X θ y (batchSafeStep X θ y) =
      batchRangeSquare X θ y / 8 *
        (eta - 4 * batchAlignment X θ y / batchRangeSquare X θ y) ^ 2 := by
    simp only [batchMajorizer, batchSafeStep, ite_eq_right hne]
    field_simp
    ring
  have hsquare : 0 ≤ batchRangeSquare X θ y / 8 *
      (eta - 4 * batchAlignment X θ y / batchRangeSquare X θ y) ^ 2 := by
    positivity
  linarith

/-- Averaged actual CE, not only its majorizer, obeys the exact residual bound. -/
theorem batchLoss_safeStep_le_residual {V : Type} [Fintype V] [Nonempty V]
    {B d : ℕ} (X : Fin B → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin B → V)
    (hR : 0 < batchRangeSquare X θ y) :
    batchLoss X (batchNextParameters X θ y) y ≤
      batchLoss X θ y
        - 2 * (batchAlignment X θ y) ^ 2 / batchRangeSquare X θ y := by
  rw [← batchMajorizer_safeStep_eq X θ y hR]
  exact batchLoss_alongNext_le_batchMajorizer X θ y (batchSafeStep_nonneg X θ y)

/-- Positive mean range-square gives strict descent of the arithmetic mean CE
for the supplied batch, including mixed labels, at the common safe update. -/
theorem batchLoss_safeStep_lt {V : Type} [Fintype V] [Nonempty V]
    {B d : ℕ} (X : Fin B → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin B → V)
    (hR : 0 < batchRangeSquare X θ y) :
    batchLoss X (batchNextParameters X θ y) y < batchLoss X θ y := by
  have hA := batchAlignment_pos_of_rangeSquare_pos X θ y hR
  have hbound := batchLoss_safeStep_le_residual X θ y hR
  have hpos : 0 < 2 * (batchAlignment X θ y) ^ 2 /
      batchRangeSquare X θ y := by positivity
  linarith

@[simp] theorem batchSafeStep_of_rangeSquare_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : batchRangeSquare X θ y = 0) :
    batchSafeStep X θ y = 0 := by
  simp [batchSafeStep, hR]

/-- At zero mean range-square the *selected* update is exactly zero.  Thus it
preserves every logit and every loss, with no fabricated positive certificate. -/
theorem batchNextParameters_eq_of_rangeSquare_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : batchRangeSquare X θ y = 0) :
    batchNextParameters X θ y = θ := by
  rw [batchNextParameters, batchSafeStep_of_rangeSquare_eq_zero X θ y hR,
    alongNext_zero]

theorem ceLogits_batchNext_eq_of_rangeSquare_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : batchRangeSquare X θ y = 0) (b : Fin B) :
    ceLogits (X b) (batchNextParameters X θ y) = ceLogits (X b) θ := by
  rw [batchNextParameters_eq_of_rangeSquare_eq_zero X θ y hR]

theorem batchLoss_batchNext_eq_of_rangeSquare_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : batchRangeSquare X θ y = 0) :
    batchLoss X (batchNextParameters X θ y) y = batchLoss X θ y := by
  rw [batchNextParameters_eq_of_rangeSquare_eq_zero X θ y hR]

/-- Two copies of identity features, used only as a finite algebraic probe. -/
abbrev mixedFeatures : Fin 2 → Matrix (Fin 2) (Fin 2) ℝ := fun _ => 1

/-- The genuinely mixed-label sample `[0, 1]`, not a same-label witness. -/
def mixedLabels : Fin 2 → Fin 2 := fun i => if i = 0 then 0 else 1

/-- Empty batches have raw loss and all coefficients zero by Lean's division
convention; they are not included in the positive-range descent statement. -/
theorem empty_batch_convention {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin 0 → V) :
    batchLoss X θ y = 0 ∧ batchMeanDirection X θ y = 0 ∧
      batchAlignment X θ y = 0 ∧ batchRangeSquare X θ y = 0 ∧
      batchSafeStep X θ y = 0 ∧ batchNextParameters X θ y = θ := by
  have hR : batchRangeSquare X θ y = 0 := by
    simp [batchRangeSquare]
  refine ⟨?_, ?_, ?_, hR, ?_, ?_⟩
  · simp [batchLoss, Hagi.Probability.FiniteFamilyConfidence.empiricalMean]
  · apply PiLp.ext
    intro j
    simp [batchMeanDirection_ofLp]
  · simp [batchAlignment, meanResidualTranspose]
  · exact batchSafeStep_of_rangeSquare_eq_zero X θ y hR
  · exact batchNextParameters_eq_of_rangeSquare_eq_zero X θ y hR

/-- At zero parameters the two own directions cancel exactly. -/
theorem mixed_own_directions_cancel :
    ceDirection (mixedFeatures 0) 0 (mixedLabels 0) +
      ceDirection (mixedFeatures 1) 0 (mixedLabels 1) = 0 := by
  apply PiLp.ext
  intro j
  fin_cases j <;>
    norm_num [mixedFeatures, mixedLabels, ceDirection, residualTranspose,
      ceResidual, ceLogits, Hagi.Energy.smax, Hagi.Prelude.softDef,
      Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- The common mean direction, rather than the own directions, is zero. -/
theorem mixed_meanDirection_eq_zero :
    batchMeanDirection mixedFeatures 0 mixedLabels = 0 := by
  apply PiLp.ext
  intro j
  fin_cases j <;>
    norm_num [batchMeanDirection, mixedFeatures, mixedLabels, ceDirection,
      residualTranspose, ceResidual, ceLogits, Hagi.Energy.smax,
      Hagi.Prelude.softDef, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

theorem mixed_alignment_eq_zero :
    batchAlignment mixedFeatures 0 mixedLabels = 0 := by
  norm_num [batchAlignment, meanResidualTranspose, mixedFeatures, mixedLabels,
    residualTranspose, ceResidual, ceLogits, Hagi.Energy.smax,
    Hagi.Prelude.softDef, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- The arithmetic mean of squared ranges is zero because the common direction
is zero, not because each own residual gradient was zero. -/
theorem mixed_rangeSquare_eq_zero :
    batchRangeSquare mixedFeatures 0 mixedLabels = 0 := by
  simp [batchRangeSquare, dirRange, ceLogits, mixed_meanDirection_eq_zero,
    Matrix.mulVec, dotProduct]

theorem mixed_safeStep_eq_zero :
    batchSafeStep mixedFeatures 0 mixedLabels = 0 :=
  batchSafeStep_of_rangeSquare_eq_zero _ _ _ mixed_rangeSquare_eq_zero

theorem mixed_nextParameters_eq_zero :
    batchNextParameters mixedFeatures 0 mixedLabels = 0 :=
  batchNextParameters_eq_of_rangeSquare_eq_zero _ _ _ mixed_rangeSquare_eq_zero

/-- Every initial two-class CE is exactly `log 2`. -/
theorem identity_CE_zero_parameters (t : Fin 2) :
    Hagi.ceOneHot t (ceLogits (1 : Matrix (Fin 2) (Fin 2) ℝ) 0) =
      Real.log 2 := by
  fin_cases t <;>
    norm_num [ceLogits, Hagi.ceOneHot, Hagi.Core.lse, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two]

/-- The mixed-label mean stays exactly `log 2` after the common safe update. -/
theorem mixed_batchLoss_before_eq_log_two :
    batchLoss mixedFeatures 0 mixedLabels = Real.log 2 := by
  norm_num [batchLoss, Hagi.Probability.FiniteFamilyConfidence.empiricalMean,
    Fin.sum_univ_two, mixedFeatures, mixedLabels,
    identity_CE_zero_parameters]

theorem mixed_batchLoss_after_eq_log_two :
    batchLoss mixedFeatures (batchNextParameters mixedFeatures 0 mixedLabels)
      mixedLabels = Real.log 2 := by
  rw [batchNextParameters_eq_of_rangeSquare_eq_zero _ _ _
    mixed_rangeSquare_eq_zero]
  exact mixed_batchLoss_before_eq_log_two

theorem mixed_batchLoss_preserved :
    batchLoss mixedFeatures (batchNextParameters mixedFeatures 0 mixedLabels)
      mixedLabels = batchLoss mixedFeatures 0 mixedLabels :=
  batchLoss_batchNext_eq_of_rangeSquare_eq_zero _ _ _ mixed_rangeSquare_eq_zero

/-- The previous target-zero safe step is still a nonzero parameter update. -/
theorem old_target_zero_next :
    ceNextParameters (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0
        (safeStepSize (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0) =
      WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then (1 : ℝ) / 4 else -1 / 4) := by
  rw [identityTwoClass_safeStepSize_test]
  apply PiLp.ext
  intro i
  fin_cases i <;>
    norm_num [ceNextParameters, ceDirection, residualTranspose, ceResidual,
      ceLogits, Hagi.Energy.smax, Hagi.Prelude.softDef, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two]

/-- The old one-target update raises the mixed-label raw arithmetic mean,
exactly the failure avoided by zeroing the common-direction step. -/
theorem old_singleTarget_mixed_increases :
    batchLoss mixedFeatures 0 mixedLabels <
      batchLoss mixedFeatures
        (ceNextParameters (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0
          (safeStepSize (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0)) mixedLabels := by
  rw [old_target_zero_next, mixed_batchLoss_before_eq_log_two]
  norm_num [batchLoss, Hagi.Probability.FiniteFamilyConfidence.empiricalMean,
    Fin.sum_univ_two, mixedFeatures, mixedLabels, ceLogits,
    Hagi.ceOneHot, Hagi.Core.lse, Matrix.mulVec, dotProduct, Matrix.one_apply]
  have hpos : (1 / 4 : ℝ) + 1 < Real.exp (1 / 4 : ℝ) :=
    Real.add_one_lt_exp (show (1 / 4 : ℝ) ≠ 0 by norm_num)
  have hnonneg : (-1 / 4 : ℝ) + 1 ≤ Real.exp (-1 / 4 : ℝ) :=
    Real.add_one_le_exp (-1 / 4)
  have hsum : (2 : ℝ) < Real.exp (1 / 4 : ℝ) + Real.exp (-1 / 4 : ℝ) := by
    nlinarith
  have hlog := Real.log_lt_log (by norm_num : (0 : ℝ) < 2) hsum
  linarith

/-- A second same-label two-sample probe makes the strict-batch theorem
explicitly nonvacuous; it is additional to, not a replacement for, the mixed
zero-direction counterexample above. -/
def sameZeroLabels : Fin 2 → Fin 2 := fun _ => 0

theorem sameZero_alignment :
    batchAlignment mixedFeatures 0 sameZeroLabels = 1 / 2 := by
  norm_num [batchAlignment, meanResidualTranspose, mixedFeatures,
    sameZeroLabels, residualTranspose, ceResidual, ceLogits,
    Hagi.Energy.smax, Hagi.Prelude.softDef, Matrix.mulVec, dotProduct,
    Fin.sum_univ_two]

theorem sameZero_rangeSquare :
    batchRangeSquare mixedFeatures 0 sameZeroLabels = 4 := by
  norm_num [batchRangeSquare, batchMeanDirection, dirRange, mixedFeatures,
    sameZeroLabels, ceDirection, residualTranspose, ceResidual, ceLogits,
    Hagi.Energy.smax, Hagi.Prelude.softDef, Matrix.mulVec, dotProduct,
    Fin.sum_univ_two]

theorem sameZero_rangeSquare_pos :
    0 < batchRangeSquare mixedFeatures 0 sameZeroLabels := by
  rw [sameZero_rangeSquare]
  norm_num

theorem sameZero_safeStep :
    batchSafeStep mixedFeatures 0 sameZeroLabels = 1 / 2 := by
  rw [batchSafeStep, sameZero_rangeSquare, sameZero_alignment]
  norm_num

theorem sameZero_batchLoss_before :
    batchLoss mixedFeatures 0 sameZeroLabels = Real.log 2 := by
  norm_num [batchLoss, Hagi.Probability.FiniteFamilyConfidence.empiricalMean,
    Fin.sum_univ_two, mixedFeatures, sameZeroLabels,
    identity_CE_zero_parameters]

theorem sameZero_batchLoss_descent :
    batchLoss mixedFeatures
      (batchNextParameters mixedFeatures 0 sameZeroLabels) sameZeroLabels <
      batchLoss mixedFeatures 0 sameZeroLabels :=
  batchLoss_safeStep_lt _ _ _ sameZero_rangeSquare_pos

theorem sameZero_batchLoss_after_lt_log_two :
    batchLoss mixedFeatures
      (batchNextParameters mixedFeatures 0 sameZeroLabels) sameZeroLabels <
      Real.log 2 := by
  rw [← sameZero_batchLoss_before]
  exact sameZero_batchLoss_descent

end Hagi.Model.BatchCEDescent
