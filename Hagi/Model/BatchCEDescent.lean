import Hagi.Model.CEDescent
import Hagi.Probability.FiniteFamilyConfidence

/-!
# Common-direction arithmetic-batch cross-entropy descent

This module proves a one-step majorization certificate for the raw arithmetic
mean of one-hot cross-entropy losses on a supplied finite batch.  The common
parameter direction is the arithmetic mean of the existing per-example
negative residual directions.  Its mean directional action is exactly minus
the squared norm of the mean residual transpose, and the quadratic coefficient
uses the arithmetic mean of the squared logit ranges of that same direction.

For an arbitrary common direction and nonnegative step, the existing Böhning
bound `Hagi.Energy.lse_shift_upper` controls second-order error; this is not a
probability tail theorem.  The selected safe step is zero when the mean squared
range is zero.  Otherwise it minimizes the named averaged quadratic majorizer
and gives strict descent of the actual arithmetic-mean batch loss.  Positive
mean squared range implies a nonempty batch and positive alignment.

The results concern only the supplied batch and quadratic majorizer.  They do
not assert global CE minimization, universal per-example descent, held-out or
statistical performance, native execution speed, or general neural-network
optimality.  Empty-batch values use Lean's `0 / 0 = 0` algebra convention and
carry no positive descent claim.

References are the repository implementations in `Model.CEDescent`,
`Model.CEGradient`, and `Energy.PoEBound`.
-/

set_option relaxedAutoImplicit false

open scoped Matrix

namespace Hagi.Model.BatchCEDescent

/-- One parameter update along an arbitrary common direction. -/
noncomputable def alongNext {d : ℕ} (θ D : EuclideanSpace ℝ (Fin d)) (eta : ℝ) :
    EuclideanSpace ℝ (Fin d) :=
  θ + eta • D

/-- One-unit range coefficient for an arbitrary direction. -/
noncomputable def dirRange {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) : ℝ :=
  2 * ∑ v, |ceLogits X D v|

/-- Exact residual action on the logits generated by an arbitrary direction. -/
noncomputable def dirAction {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V)
    (D : EuclideanSpace ℝ (Fin d)) : ℝ :=
  ∑ v, ceResidual X θ t v * ceLogits X D v

/-- The full quadratic majorizer in an arbitrary direction. -/
noncomputable def dirMajorizer {V : Type} [Fintype V] [Nonempty V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V)
    (D : EuclideanSpace ℝ (Fin d)) (eta : ℝ) : ℝ :=
  Hagi.ceOneHot t (ceLogits X θ) + eta * dirAction X θ t D
    + (eta * dirRange X D) ^ 2 / 8

@[simp] theorem alongNext_zero {d : ℕ} (θ D : EuclideanSpace ℝ (Fin d)) :
    alongNext θ D 0 = θ := by
  simp [alongNext]

/-- Matrix multiplication turns the common parameter displacement into the
same eta-scaled logit displacement for every sample. -/
theorem ceLogits_alongNext_apply {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (eta : ℝ) (v : V) :
    ceLogits X (alongNext θ D eta) v = ceLogits X θ v + eta * ceLogits X D v := by
  simp only [alongNext, ceLogits, Matrix.mulVec, dotProduct, PiLp.add_apply,
    PiLp.smul_apply, smul_eq_mul, Finset.mul_sum, mul_add,
    Finset.sum_add_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro j _hj
  ring

/-- Exact first-order displacement law for an arbitrary direction. -/
theorem dir_first_order_eq {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d)) (t : V)
    (eta : ℝ) :
    ∑ v, ceResidual X θ t v *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      eta * dirAction X θ t D := by
  simp only [ceLogits_alongNext_apply, add_sub_cancel_left, dirAction,
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro v _hv
  ring

set_option linter.unusedDecidableInType false in
/-- The existing Fréchet derivative has exactly the `dirAction` form. -/
theorem fderiv_dirAction {V : Type} [Fintype V] [Nonempty V] [DecidableEq V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) :
    fderiv ℝ (fun w : EuclideanSpace ℝ (Fin d) =>
      Hagi.ceOneHot t (ceLogits X w)) θ D = dirAction X θ t D := by
  simp only [ceLogits]
  rw [CEGradient.fderiv_ceOneHot_mulVec]
  apply Finset.sum_congr rfl
  intro v _hv
  by_cases hv : v = t <;>
    simp [ceResidual, ceLogits, Hagi.Energy.smax, hv]

/-- The arbitrary-direction range coefficient is nonnegative. -/
theorem dirRange_nonneg {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) :
    0 ≤ dirRange X D := by
  unfold dirRange
  positivity

/-- At nonnegative eta the actual displacement satisfies the range premise
needed by the existing `lse_shift_upper`, with no premise omitted. -/
theorem dir_displacement_range {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    {eta : ℝ} (heta : 0 ≤ eta) (u v : V) :
    (ceLogits X (alongNext θ D eta) u - ceLogits X θ u)
      - (ceLogits X (alongNext θ D eta) v - ceLogits X θ v)
      ≤ eta * dirRange X D := by
  have hsub : ∀ w : V, |ceLogits X D w| ≤ ∑ z, |ceLogits X D z| := by
    intro w
    exact Finset.single_le_sum
      (fun z _hz => abs_nonneg (ceLogits X D z)) (Finset.mem_univ w)
  have htri : ceLogits X D u - ceLogits X D v ≤
      |ceLogits X D u| + |ceLogits X D v| := by
    exact le_trans (le_abs_self _) (abs_sub _ _)
  rw [ceLogits_alongNext_apply, ceLogits_alongNext_apply]
  have hmul := mul_le_mul_of_nonneg_left
    (add_le_add (hsub u) (hsub v)) heta
  have hmul' := mul_le_mul_of_nonneg_left htri heta
  dsimp [dirRange]
  linarith

/-- Zero range is exactly joint vanishing of all directional logits. -/
theorem dirRange_eq_zero_iff {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) :
    dirRange X D = 0 ↔ ∀ v, ceLogits X D v = 0 := by
  constructor
  · intro hr v
    have hsum : ∑ w, |ceLogits X D w| = 0 := by
      dsimp [dirRange] at hr
      linarith
    have habs := (Finset.sum_eq_zero_iff_of_nonneg
      (fun w _hw => abs_nonneg (ceLogits X D w))).mp hsum
      v (Finset.mem_univ v)
    exact abs_eq_zero.mp habs
  · intro hv
    simp [dirRange, hv]

/-- General one-example Böhning upper bound along an arbitrary direction. -/
theorem ceOneHot_alongNext_le_majorizer {V : Type} [Fintype V] [Nonempty V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) {eta : ℝ} (heta : 0 ≤ eta) :
    Hagi.ceOneHot t (ceLogits X (alongNext θ D eta)) ≤
      dirMajorizer X θ t D eta := by
  have hlse := Hagi.Energy.lse_shift_upper (ceLogits X θ)
    (ceLogits X (alongNext θ D eta)) (eta * dirRange X D)
    (dir_displacement_range X θ D heta)
  have hlin := dir_first_order_eq X θ D t eta
  have ht := ceLogits_alongNext_apply X θ D eta t
  classical
  have honehot : ∑ v, (if v = t then (1 : ℝ) else 0) *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      ceLogits X (alongNext θ D eta) t - ceLogits X θ t := by
    simp
  simp only [ceResidual, sub_mul, Finset.sum_sub_distrib] at hlin
  rw [honehot, ht] at hlin
  have hsoft : ∑ v, Hagi.Energy.smax (ceLogits X θ) v *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      eta * dirAction X θ t D + eta * ceLogits X D t := by
    linarith
  rw [hsoft] at hlse
  unfold Hagi.ceOneHot Hagi.Core.lse
  unfold dirMajorizer
  rw [ht]
  dsimp [Hagi.Core.ceOneHot, Hagi.Core.lse]
  linarith

/-- Expanded general majorization certificate, retaining eta and range. -/
theorem ceOneHot_alongNext_le {V : Type} [Fintype V] [Nonempty V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) {eta : ℝ} (heta : 0 ≤ eta) :
    Hagi.ceOneHot t (ceLogits X (alongNext θ D eta)) ≤
      Hagi.ceOneHot t (ceLogits X θ) + eta * dirAction X θ t D
        + (eta * dirRange X D) ^ 2 / 8 :=
  ceOneHot_alongNext_le_majorizer X θ D t heta

/-! ## Arithmetic batch: one common averaged direction -/

/-- Raw arithmetic mean CE on the supplied samples.  The empty-batch value is
Lean's `0 / 0 = 0` algebra convention, not a statistical estimate. -/
noncomputable def batchLoss {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ :=
  Hagi.Probability.FiniteFamilyConfidence.empiricalMean
    (fun b t => Hagi.ceOneHot t (ceLogits (X b) θ)) y

/-- Coordinatewise arithmetic mean of the exact residual transposes. -/
noncomputable def meanResidualTranspose {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : Fin d → ℝ :=
  fun j => (∑ b, residualTranspose (X b) θ (y b) j) / (B : ℝ)

/-- Arithmetic mean of the individual negative-residual directions.  This is
the one common direction used in every individual majorizer below. -/
noncomputable def batchMeanDirection {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : EuclideanSpace ℝ (Fin d) :=
  WithLp.toLp 2 (fun j =>
    (∑ b, (ceDirection (X b) θ (y b)).ofLp j) / (B : ℝ))

/-- Alignment is based on the mean residual transpose, never on a mean of
individual alignments. -/
noncomputable def batchAlignment {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ :=
  ∑ j, (meanResidualTranspose X θ y j) ^ 2

/-- Arithmetic mean of the squared ranges of the *same* common direction. -/
noncomputable def batchRangeSquare {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ :=
  (∑ b, (dirRange (X b) (batchMeanDirection X θ y)) ^ 2) / (B : ℝ)

/-- Mean directional action, before specializing to the common direction. -/
noncomputable def batchMeanAction {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (D : EuclideanSpace ℝ (Fin d)) : ℝ :=
  (∑ b, dirAction (X b) θ (y b) D) / (B : ℝ)

@[simp] theorem batchMeanDirection_ofLp {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (j : Fin d) :
    (batchMeanDirection X θ y).ofLp j =
      (∑ b, (ceDirection (X b) θ (y b)).ofLp j) / (B : ℝ) := rfl

/-- The mean of the own negative directions is minus the mean residual
transpose; this is a coordinate equality, not an alignment assertion. -/
theorem batchMeanDirection_eq_neg_meanResidualTranspose
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) :
    batchMeanDirection X θ y =
      WithLp.toLp 2 (fun j => -meanResidualTranspose X θ y j) := by
  apply PiLp.ext
  intro j
  rw [batchMeanDirection_ofLp]
  simp only [ceDirection_ofLp, meanResidualTranspose]
  rw [Finset.sum_neg_distrib]
  ring

/-- Residual action is the dot product with the generating direction. -/
theorem dirAction_eq_dot {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d)) (t : V) :
    dirAction X θ t D = ∑ j, residualTranspose X θ t j * D.ofLp j := by
  simp only [dirAction, ceLogits, residualTranspose, Matrix.mulVec, dotProduct,
    Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _hj
  apply Finset.sum_congr rfl
  intro v _hv
  ring

/-- Averaging the exact actions on the common direction gives minus its
alignment.  At `B = 0` both sides are the algebra convention zero. -/
theorem batchMeanAction_common {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) :
    batchMeanAction X θ y (batchMeanDirection X θ y) =
      -batchAlignment X θ y := by
  classical
  by_cases hB : B = 0
  · subst B
    simp [batchMeanAction, batchAlignment, meanResidualTranspose]
  have hBreal : (B : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hB
  have hdir_at (b : Fin B) :
      dirAction (X b) θ (y b) (batchMeanDirection X θ y) =
        -∑ j, residualTranspose (X b) θ (y b) j *
          meanResidualTranspose X θ y j := by
    rw [dirAction_eq_dot, batchMeanDirection_eq_neg_meanResidualTranspose]
    simp only [meanResidualTranspose]
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro j _hj
    ring
  have hsum : (∑ b, dirAction (X b) θ (y b) (batchMeanDirection X θ y)) =
      -∑ j, (∑ b, residualTranspose (X b) θ (y b) j) *
        meanResidualTranspose X θ y j := by
    rw [Finset.sum_congr rfl (fun b _hb => hdir_at b), Finset.sum_neg_distrib,
      Finset.sum_comm]
    congr 1
    apply Finset.sum_congr rfl
    intro j _hj
    rw [Finset.sum_mul]
  have hcoord (j : Fin d) :
      (∑ b, residualTranspose (X b) θ (y b) j) =
        (B : ℝ) * meanResidualTranspose X θ y j := by
    simp only [meanResidualTranspose]
    field_simp
  have havg :
      (∑ j, (∑ b, residualTranspose (X b) θ (y b) j) *
        meanResidualTranspose X θ y j) / (B : ℝ) =
      ∑ j, (meanResidualTranspose X θ y j) ^ 2 := by
    rw [Finset.sum_div]
    apply Finset.sum_congr rfl
    intro j _hj
    rw [hcoord j]
    field_simp
  unfold batchMeanAction batchAlignment
  rw [hsum, neg_div, havg]

/-- Both scalar batch coefficients are nonnegative. -/
theorem batchAlignment_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : 0 ≤ batchAlignment X θ y := by
  unfold batchAlignment
  positivity

theorem batchRangeSquare_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : 0 ≤ batchRangeSquare X θ y := by
  unfold batchRangeSquare
  positivity

/-- Positive range-square belongs to the genuinely nonempty-batch class. -/
theorem batch_pos_of_rangeSquare_pos
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : 0 < batchRangeSquare X θ y) : 0 < B := by
  apply Nat.pos_of_ne_zero
  intro hB
  subst B
  simp [batchRangeSquare] at hR

/-- Zero mean alignment collapses the common direction itself to zero. -/
theorem batchMeanDirection_eq_zero_of_alignment_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hA : batchAlignment X θ y = 0) :
    batchMeanDirection X θ y = 0 := by
  have hm : ∀ j ∈ (Finset.univ : Finset (Fin d)),
      meanResidualTranspose X θ y j = 0 := by
    apply (Finset.sum_sq_eq_zero_iff Finset.univ
      (meanResidualTranspose X θ y)).mp
    simpa [batchAlignment] using hA
  rw [batchMeanDirection_eq_neg_meanResidualTranspose]
  apply PiLp.ext
  intro j
  simp [hm j (Finset.mem_univ j)]

/-- Positive mean common-direction range-square forces positive alignment by
forcing the common direction to be nonzero; positivity is not an assumption. -/
theorem batchAlignment_pos_of_rangeSquare_pos
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : 0 < batchRangeSquare X θ y) :
    0 < batchAlignment X θ y := by
  apply lt_of_le_of_ne (batchAlignment_nonneg X θ y)
  intro hne
  have hA : batchAlignment X θ y = 0 := hne.symm
  have hD := batchMeanDirection_eq_zero_of_alignment_eq_zero X θ y hA
  have hR0 : batchRangeSquare X θ y = 0 := by
    simp [batchRangeSquare, dirRange, ceLogits, hD, Matrix.mulVec, dotProduct]
  exact (ne_of_gt hR) hR0

/-- Safe minimizer of the common-direction averaged quadratic majorizer. -/
noncomputable def batchSafeStep {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : ℝ :=
  if batchRangeSquare X θ y = 0 then 0
  else 4 * batchAlignment X θ y / batchRangeSquare X θ y

/-- Averaged majorizer for one common step. -/
noncomputable def batchMajorizer {V : Type} [Fintype V] [Nonempty V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (eta : ℝ) : ℝ :=
  batchLoss X θ y - eta * batchAlignment X θ y
    + eta ^ 2 * batchRangeSquare X θ y / 8

/-- The actual parameter update shared by every sample. -/
noncomputable def batchNextParameters {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : EuclideanSpace ℝ (Fin d) :=
  alongNext θ (batchMeanDirection X θ y) (batchSafeStep X θ y)

/-- Average the general individual bounds, all evaluated along the same common
direction.  No universal per-example descent is asserted. -/
theorem batchLoss_alongNext_le_batchMajorizer
    {V : Type} [Fintype V] [Nonempty V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) {eta : ℝ} (heta : 0 ≤ eta) :
    batchLoss X (alongNext θ (batchMeanDirection X θ y) eta) y ≤
      batchMajorizer X θ y eta := by
  let D := batchMeanDirection X θ y
  have hsum : (∑ b, Hagi.ceOneHot (y b)
        (ceLogits (X b) (alongNext θ D eta))) ≤
      ∑ b, (Hagi.ceOneHot (y b) (ceLogits (X b) θ)
        + eta * dirAction (X b) θ (y b) D
        + (eta * dirRange (X b) D) ^ 2 / 8) := by
    exact Finset.sum_le_sum (fun b _hb =>
      ceOneHot_alongNext_le (X b) θ D (y b) heta)
  have hdiv := div_le_div_of_nonneg_right hsum (Nat.cast_nonneg B)
  have hsumAction :
      (∑ b, eta * dirAction (X b) θ (y b) D) =
        eta * ∑ b, dirAction (X b) θ (y b) D := by
    rw [Finset.mul_sum]
  have hsumRange :
      (∑ b, (eta * dirRange (X b) D) ^ 2 / 8) =
        eta ^ 2 * (∑ b, (dirRange (X b) D) ^ 2) / 8 := by
    calc
      (∑ b, (eta * dirRange (X b) D) ^ 2 / 8) =
          ∑ b, eta ^ 2 * ((dirRange (X b) D) ^ 2 / 8) := by
        apply Finset.sum_congr rfl
        intro b _hb
        ring
      _ = eta ^ 2 * ∑ b, (dirRange (X b) D) ^ 2 / 8 := by
        rw [Finset.mul_sum]
      _ = eta ^ 2 * ((∑ b, (dirRange (X b) D) ^ 2) / 8) := by
        rw [Finset.sum_div]
      _ = eta ^ 2 * (∑ b, (dirRange (X b) D) ^ 2) / 8 := by ring
  simp only [Finset.sum_add_distrib, hsumAction, hsumRange] at hdiv
  have hmean := batchMeanAction_common X θ y
  unfold batchMeanAction at hmean
  dsimp [D] at hdiv hmean
  unfold batchMajorizer batchLoss batchRangeSquare
  unfold Hagi.Probability.FiniteFamilyConfidence.empiricalMean
  calc
    (∑ b, Hagi.ceOneHot (y b)
        (ceLogits (X b) (alongNext θ (batchMeanDirection X θ y) eta))) /
        (B : ℝ) ≤
      (∑ b, Hagi.ceOneHot (y b) (ceLogits (X b) θ)
        + eta * (∑ b, dirAction (X b) θ (y b) (batchMeanDirection X θ y))
        + eta ^ 2 * (∑ b, (dirRange (X b) (batchMeanDirection X θ y)) ^ 2) / 8) /
        (B : ℝ) := hdiv
    _ = (∑ b, Hagi.ceOneHot (y b) (ceLogits (X b) θ)) / (B : ℝ)
        - eta * batchAlignment X θ y
        + eta ^ 2 *
          ((∑ b, (dirRange (X b) (batchMeanDirection X θ y)) ^ 2) / (B : ℝ)) / 8 := by
      linear_combination eta * hmean


/-- Positive range-square makes the selected common step positive. -/
theorem batchSafeStep_pos_of_rangeSquare_pos
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : 0 < batchRangeSquare X θ y) :
    0 < batchSafeStep X θ y := by
  have hA := batchAlignment_pos_of_rangeSquare_pos X θ y hR
  rw [batchSafeStep, ite_eq_right (ne_of_gt hR)]
  exact div_pos (by positivity) hR

/-- The zero-range branch and all positive-range branches are nonnegative. -/
theorem batchSafeStep_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) : 0 ≤ batchSafeStep X θ y := by
  by_cases hR : batchRangeSquare X θ y = 0
  · simp [batchSafeStep, hR]
  · have hRpos : 0 < batchRangeSquare X θ y :=
      lt_of_le_of_ne (batchRangeSquare_nonneg X θ y) (Ne.symm hR)
    exact (batchSafeStep_pos_of_rangeSquare_pos X θ y hRpos).le

/-- Exact minimizer residual for the averaged majorizer. -/
theorem batchMajorizer_safeStep_eq {V : Type} [Fintype V] [Nonempty V]
    {B d : ℕ} (X : Fin B → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin B → V)
    (hR : 0 < batchRangeSquare X θ y) :
    batchMajorizer X θ y (batchSafeStep X θ y) =
      batchLoss X θ y
        - 2 * (batchAlignment X θ y) ^ 2 / batchRangeSquare X θ y := by
  simp only [batchMajorizer, batchSafeStep, ite_eq_right (ne_of_gt hR)]
  field_simp
  ring

/-- The common safe step minimizes the averaged majorizer over every real eta. -/
theorem batchMajorizer_safeStep_le {V : Type} [Fintype V] [Nonempty V]
    {B d : ℕ} (X : Fin B → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin B → V)
    (hR : 0 < batchRangeSquare X θ y) (eta : ℝ) :
    batchMajorizer X θ y (batchSafeStep X θ y) ≤
      batchMajorizer X θ y eta := by
  have hne : batchRangeSquare X θ y ≠ 0 := ne_of_gt hR
  have hdiff : batchMajorizer X θ y eta
      - batchMajorizer X θ y (batchSafeStep X θ y) =
      batchRangeSquare X θ y / 8 *
        (eta - 4 * batchAlignment X θ y / batchRangeSquare X θ y) ^ 2 := by
    simp only [batchMajorizer, batchSafeStep, ite_eq_right hne]
    field_simp
    ring
  have hsquare : 0 ≤ batchRangeSquare X θ y / 8 *
      (eta - 4 * batchAlignment X θ y / batchRangeSquare X θ y) ^ 2 := by
    positivity
  linarith

/-- Averaged actual CE, not only its majorizer, obeys the exact residual bound. -/
theorem batchLoss_safeStep_le_residual {V : Type} [Fintype V] [Nonempty V]
    {B d : ℕ} (X : Fin B → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin B → V)
    (hR : 0 < batchRangeSquare X θ y) :
    batchLoss X (batchNextParameters X θ y) y ≤
      batchLoss X θ y
        - 2 * (batchAlignment X θ y) ^ 2 / batchRangeSquare X θ y := by
  rw [← batchMajorizer_safeStep_eq X θ y hR]
  exact batchLoss_alongNext_le_batchMajorizer X θ y (batchSafeStep_nonneg X θ y)

/-- Positive mean range-square gives strict descent of the arithmetic mean CE
for the supplied batch, including mixed labels, at the common safe update. -/
theorem batchLoss_safeStep_lt {V : Type} [Fintype V] [Nonempty V]
    {B d : ℕ} (X : Fin B → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin B → V)
    (hR : 0 < batchRangeSquare X θ y) :
    batchLoss X (batchNextParameters X θ y) y < batchLoss X θ y := by
  have hA := batchAlignment_pos_of_rangeSquare_pos X θ y hR
  have hbound := batchLoss_safeStep_le_residual X θ y hR
  have hpos : 0 < 2 * (batchAlignment X θ y) ^ 2 /
      batchRangeSquare X θ y := by positivity
  linarith

@[simp] theorem batchSafeStep_of_rangeSquare_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : batchRangeSquare X θ y = 0) :
    batchSafeStep X θ y = 0 := by
  simp [batchSafeStep, hR]

/-- At zero mean range-square the *selected* update is exactly zero.  Thus it
preserves every logit and every loss, with no fabricated positive certificate. -/
theorem batchNextParameters_eq_of_rangeSquare_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : batchRangeSquare X θ y = 0) :
    batchNextParameters X θ y = θ := by
  rw [batchNextParameters, batchSafeStep_of_rangeSquare_eq_zero X θ y hR,
    alongNext_zero]

theorem ceLogits_batchNext_eq_of_rangeSquare_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : batchRangeSquare X θ y = 0) (b : Fin B) :
    ceLogits (X b) (batchNextParameters X θ y) = ceLogits (X b) θ := by
  rw [batchNextParameters_eq_of_rangeSquare_eq_zero X θ y hR]

theorem batchLoss_batchNext_eq_of_rangeSquare_eq_zero
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d))
    (y : Fin B → V) (hR : batchRangeSquare X θ y = 0) :
    batchLoss X (batchNextParameters X θ y) y = batchLoss X θ y := by
  rw [batchNextParameters_eq_of_rangeSquare_eq_zero X θ y hR]

/-- Two copies of identity features, used only as a finite algebraic probe. -/
abbrev mixedFeatures : Fin 2 → Matrix (Fin 2) (Fin 2) ℝ := fun _ => 1

/-- The genuinely mixed-label sample `[0, 1]`, not a same-label witness. -/
def mixedLabels : Fin 2 → Fin 2 := fun i => if i = 0 then 0 else 1

/-- Empty batches have raw loss and all coefficients zero by Lean's division
convention; they are not included in the positive-range descent statement. -/
theorem empty_batch_convention {V : Type} [Fintype V] {d : ℕ}
    (X : Fin 0 → Matrix V (Fin d) ℝ)
    (θ : EuclideanSpace ℝ (Fin d)) (y : Fin 0 → V) :
    batchLoss X θ y = 0 ∧ batchMeanDirection X θ y = 0 ∧
      batchAlignment X θ y = 0 ∧ batchRangeSquare X θ y = 0 ∧
      batchSafeStep X θ y = 0 ∧ batchNextParameters X θ y = θ := by
  have hR : batchRangeSquare X θ y = 0 := by
    simp [batchRangeSquare]
  refine ⟨?_, ?_, ?_, hR, ?_, ?_⟩
  · simp [batchLoss, Hagi.Probability.FiniteFamilyConfidence.empiricalMean]
  · apply PiLp.ext
    intro j
    simp [batchMeanDirection_ofLp]
  · simp [batchAlignment, meanResidualTranspose]
  · exact batchSafeStep_of_rangeSquare_eq_zero X θ y hR
  · exact batchNextParameters_eq_of_rangeSquare_eq_zero X θ y hR

/-- At zero parameters the two own directions cancel exactly. -/
theorem mixed_own_directions_cancel :
    ceDirection (mixedFeatures 0) 0 (mixedLabels 0) +
      ceDirection (mixedFeatures 1) 0 (mixedLabels 1) = 0 := by
  apply PiLp.ext
  intro j
  fin_cases j <;>
    norm_num [mixedFeatures, mixedLabels, ceDirection, residualTranspose,
      ceResidual, ceLogits, Hagi.Energy.smax, Hagi.Prelude.softDef,
      Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- The common mean direction, rather than the own directions, is zero. -/
theorem mixed_meanDirection_eq_zero :
    batchMeanDirection mixedFeatures 0 mixedLabels = 0 := by
  apply PiLp.ext
  intro j
  fin_cases j <;>
    norm_num [batchMeanDirection, mixedFeatures, mixedLabels, ceDirection,
      residualTranspose, ceResidual, ceLogits, Hagi.Energy.smax,
      Hagi.Prelude.softDef, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

theorem mixed_alignment_eq_zero :
    batchAlignment mixedFeatures 0 mixedLabels = 0 := by
  norm_num [batchAlignment, meanResidualTranspose, mixedFeatures, mixedLabels,
    residualTranspose, ceResidual, ceLogits, Hagi.Energy.smax,
    Hagi.Prelude.softDef, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- The arithmetic mean of squared ranges is zero because the common direction
is zero, not because each own residual gradient was zero. -/
theorem mixed_rangeSquare_eq_zero :
    batchRangeSquare mixedFeatures 0 mixedLabels = 0 := by
  simp [batchRangeSquare, dirRange, ceLogits, mixed_meanDirection_eq_zero,
    Matrix.mulVec, dotProduct]

theorem mixed_safeStep_eq_zero :
    batchSafeStep mixedFeatures 0 mixedLabels = 0 :=
  batchSafeStep_of_rangeSquare_eq_zero _ _ _ mixed_rangeSquare_eq_zero

theorem mixed_nextParameters_eq_zero :
    batchNextParameters mixedFeatures 0 mixedLabels = 0 :=
  batchNextParameters_eq_of_rangeSquare_eq_zero _ _ _ mixed_rangeSquare_eq_zero

/-- Every initial two-class CE is exactly `log 2`. -/
theorem identity_CE_zero_parameters (t : Fin 2) :
    Hagi.ceOneHot t (ceLogits (1 : Matrix (Fin 2) (Fin 2) ℝ) 0) =
      Real.log 2 := by
  fin_cases t <;>
    norm_num [ceLogits, Hagi.ceOneHot, Hagi.Core.lse, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two]

/-- The mixed-label mean stays exactly `log 2` after the common safe update. -/
theorem mixed_batchLoss_before_eq_log_two :
    batchLoss mixedFeatures 0 mixedLabels = Real.log 2 := by
  norm_num [batchLoss, Hagi.Probability.FiniteFamilyConfidence.empiricalMean,
    Fin.sum_univ_two, mixedFeatures, mixedLabels,
    identity_CE_zero_parameters]

theorem mixed_batchLoss_after_eq_log_two :
    batchLoss mixedFeatures (batchNextParameters mixedFeatures 0 mixedLabels)
      mixedLabels = Real.log 2 := by
  rw [batchNextParameters_eq_of_rangeSquare_eq_zero _ _ _
    mixed_rangeSquare_eq_zero]
  exact mixed_batchLoss_before_eq_log_two

theorem mixed_batchLoss_preserved :
    batchLoss mixedFeatures (batchNextParameters mixedFeatures 0 mixedLabels)
      mixedLabels = batchLoss mixedFeatures 0 mixedLabels :=
  batchLoss_batchNext_eq_of_rangeSquare_eq_zero _ _ _ mixed_rangeSquare_eq_zero

/-- The previous target-zero safe step is still a nonzero parameter update. -/
theorem old_target_zero_next :
    ceNextParameters (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0
        (safeStepSize (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0) =
      WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then (1 : ℝ) / 4 else -1 / 4) := by
  rw [identityTwoClass_safeStepSize_test]
  apply PiLp.ext
  intro i
  fin_cases i <;>
    norm_num [ceNextParameters, ceDirection, residualTranspose, ceResidual,
      ceLogits, Hagi.Energy.smax, Hagi.Prelude.softDef, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two]

/-- The old one-target update raises the mixed-label raw arithmetic mean,
exactly the failure avoided by zeroing the common-direction step. -/
theorem old_singleTarget_mixed_increases :
    batchLoss mixedFeatures 0 mixedLabels <
      batchLoss mixedFeatures
        (ceNextParameters (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0
          (safeStepSize (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0)) mixedLabels := by
  rw [old_target_zero_next, mixed_batchLoss_before_eq_log_two]
  norm_num [batchLoss, Hagi.Probability.FiniteFamilyConfidence.empiricalMean,
    Fin.sum_univ_two, mixedFeatures, mixedLabels, ceLogits,
    Hagi.ceOneHot, Hagi.Core.lse, Matrix.mulVec, dotProduct, Matrix.one_apply]
  have hpos : (1 / 4 : ℝ) + 1 < Real.exp (1 / 4 : ℝ) :=
    Real.add_one_lt_exp (show (1 / 4 : ℝ) ≠ 0 by norm_num)
  have hnonneg : (-1 / 4 : ℝ) + 1 ≤ Real.exp (-1 / 4 : ℝ) :=
    Real.add_one_le_exp (-1 / 4)
  have hsum : (2 : ℝ) < Real.exp (1 / 4 : ℝ) + Real.exp (-1 / 4 : ℝ) := by
    nlinarith
  have hlog := Real.log_lt_log (by norm_num : (0 : ℝ) < 2) hsum
  linarith

/-- A second same-label two-sample probe makes the strict-batch theorem
explicitly nonvacuous; it is additional to, not a replacement for, the mixed
zero-direction counterexample above. -/
def sameZeroLabels : Fin 2 → Fin 2 := fun _ => 0

theorem sameZero_alignment :
    batchAlignment mixedFeatures 0 sameZeroLabels = 1 / 2 := by
  norm_num [batchAlignment, meanResidualTranspose, mixedFeatures,
    sameZeroLabels, residualTranspose, ceResidual, ceLogits,
    Hagi.Energy.smax, Hagi.Prelude.softDef, Matrix.mulVec, dotProduct,
    Fin.sum_univ_two]

theorem sameZero_rangeSquare :
    batchRangeSquare mixedFeatures 0 sameZeroLabels = 4 := by
  norm_num [batchRangeSquare, batchMeanDirection, dirRange, mixedFeatures,
    sameZeroLabels, ceDirection, residualTranspose, ceResidual, ceLogits,
    Hagi.Energy.smax, Hagi.Prelude.softDef, Matrix.mulVec, dotProduct,
    Fin.sum_univ_two]

theorem sameZero_rangeSquare_pos :
    0 < batchRangeSquare mixedFeatures 0 sameZeroLabels := by
  rw [sameZero_rangeSquare]
  norm_num

theorem sameZero_safeStep :
    batchSafeStep mixedFeatures 0 sameZeroLabels = 1 / 2 := by
  rw [batchSafeStep, sameZero_rangeSquare, sameZero_alignment]
  norm_num

theorem sameZero_batchLoss_before :
    batchLoss mixedFeatures 0 sameZeroLabels = Real.log 2 := by
  norm_num [batchLoss, Hagi.Probability.FiniteFamilyConfidence.empiricalMean,
    Fin.sum_univ_two, mixedFeatures, sameZeroLabels,
    identity_CE_zero_parameters]

theorem sameZero_batchLoss_descent :
    batchLoss mixedFeatures
      (batchNextParameters mixedFeatures 0 sameZeroLabels) sameZeroLabels <
      batchLoss mixedFeatures 0 sameZeroLabels :=
  batchLoss_safeStep_lt _ _ _ sameZero_rangeSquare_pos

theorem sameZero_batchLoss_after_lt_log_two :
    batchLoss mixedFeatures
      (batchNextParameters mixedFeatures 0 sameZeroLabels) sameZeroLabels <
      Real.log 2 := by
  rw [← sameZero_batchLoss_before]
  exact sameZero_batchLoss_descent

end Hagi.Model.BatchCEDescent
