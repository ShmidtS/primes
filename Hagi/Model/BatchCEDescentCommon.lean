import Hagi.Model.CEDescent
import Hagi.Model.CEGroupedScale
import Hagi.Probability.FiniteFamilyConfidence
import Hagi.Step.ProjectionDescent
import Hagi.Step.SafeQPStep
import Hagi.Optimization.MirrorHedge

/-!
# BatchCEDescentCommon

Common-direction primitives for arithmetic-batch CE descent: `alongNext`, `dirRange`, `dirAction`, `dirMajorizer`, and one-hot CE upper bounds.
-/

set_option relaxedAutoImplicit false

open scoped Matrix
open InnerProductSpace

namespace Hagi.Model.BatchCEDescent


/-- One parameter update along an arbitrary common direction. -/
noncomputable def alongNext {d : ℕ} (θ D : EuclideanSpace ℝ (Fin d)) (eta : ℝ) :
    EuclideanSpace ℝ (Fin d) :=
  θ + eta • D

/-- One-unit range coefficient for an arbitrary direction. -/
noncomputable def dirRange {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) : ℝ :=
  2 * ∑ v, |ceLogits X D v|

/-- A feature-only bound for every sample's squared arbitrary-direction
range.  The sum over the batch makes the bound independent of the selected
sample while retaining the actual per-sample feature masses. -/
noncomputable def batchFeatureRangeCoefficient {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) : ℝ :=
  4 * ∑ b, (CEGroupedScale.featureAbsSum (X b)) ^ 2

/-- The batch feature-range coefficient is nonnegative on every finite
carrier, including empty batches and empty logit or parameter types. -/
theorem batchFeatureRangeCoefficient_nonneg {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) :
    0 ≤ batchFeatureRangeCoefficient X := by
  unfold batchFeatureRangeCoefficient
  positivity

/-- Exact residual action on the logits generated by an arbitrary direction. -/
noncomputable def dirAction {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V)
    (D : EuclideanSpace ℝ (Fin d)) : ℝ :=
  ∑ v, ceResidual X θ t v * ceLogits X D v

/-- The full quadratic majorizer in an arbitrary direction. -/
noncomputable def dirMajorizer {V : Type} [Fintype V] [Nonempty V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ : EuclideanSpace ℝ (Fin d)) (t : V)
    (D : EuclideanSpace ℝ (Fin d)) (eta : ℝ) : ℝ :=
  Hagi.ceOneHot t (ceLogits X θ) + eta * dirAction X θ t D
    + (eta * dirRange X D) ^ 2 / 8

@[simp] theorem alongNext_zero {d : ℕ} (θ D : EuclideanSpace ℝ (Fin d)) :
    alongNext θ D 0 = θ := by
  simp [alongNext]

/-- Matrix multiplication turns the common parameter displacement into the
same eta-scaled logit displacement for every sample. -/
theorem ceLogits_alongNext_apply {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (eta : ℝ) (v : V) :
    ceLogits X (alongNext θ D eta) v = ceLogits X θ v + eta * ceLogits X D v := by
  simp only [alongNext, ceLogits, Matrix.mulVec, dotProduct, PiLp.add_apply,
    PiLp.smul_apply, smul_eq_mul, Finset.mul_sum, mul_add,
    Finset.sum_add_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro j _hj
  ring

/-- Exact first-order displacement law for an arbitrary direction. -/
theorem dir_first_order_eq {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d)) (t : V)
    (eta : ℝ) :
    ∑ v, ceResidual X θ t v *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      eta * dirAction X θ t D := by
  simp only [ceLogits_alongNext_apply, add_sub_cancel_left, dirAction,
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro v _hv
  ring

set_option linter.unusedDecidableInType false in
/-- The existing Fréchet derivative has exactly the `dirAction` form. -/
theorem fderiv_dirAction {V : Type} [Fintype V] [Nonempty V] [DecidableEq V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) :
    fderiv ℝ (fun w : EuclideanSpace ℝ (Fin d) =>
      Hagi.ceOneHot t (ceLogits X w)) θ D = dirAction X θ t D := by
  simp only [ceLogits]
  rw [CEGradient.fderiv_ceOneHot_mulVec]
  apply Finset.sum_congr rfl
  intro v _hv
  by_cases hv : v = t <;>
    simp [ceResidual, ceLogits, Hagi.Energy.smax, hv]

/-- The arbitrary-direction range coefficient is nonnegative. -/
theorem dirRange_nonneg {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) :
    0 ≤ dirRange X D := by
  unfold dirRange
  positivity

/-- The feature mass and Euclidean norm bound every sample's exact squared
range.  The coordinate estimate uses Mathlib's verified
`EuclideanSpace.real_norm_sq_eq` bridge from
`Analysis.InnerProductSpace.PiL2`; no inhabited-carrier assumption is needed. -/
theorem dirRange_sq_le_batchFeatureRangeCoefficient_mul_norm_sq
    {V : Type} [Fintype V] {B d : ℕ}
    (X : Fin B → Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) (b : Fin B) :
    (dirRange (X b) D) ^ 2 ≤ batchFeatureRangeCoefficient X * ‖D‖ ^ 2 := by
  have hcoord (j : Fin d) : |D.ofLp j| ≤ ‖D‖ := by
    have hsq : (D.ofLp j) ^ 2 ≤ ‖D‖ ^ 2 := by
      rw [EuclideanSpace.real_norm_sq_eq]
      exact Finset.single_le_sum (fun k _hk => sq_nonneg (D.ofLp k))
        (Finset.mem_univ j)
    have habs := sq_le_sq.mp hsq
    simpa only [abs_of_nonneg (norm_nonneg D)] using habs
  have hlogit (v : V) : |ceLogits (X b) D v| ≤
      (∑ j, |(X b) v j|) * ‖D‖ := by
    calc
      |ceLogits (X b) D v| = |∑ j, (X b) v j * D.ofLp j| := rfl
      _ ≤ ∑ j, |(X b) v j * D.ofLp j| := Finset.abs_sum_le_sum_abs _ _
      _ = ∑ j, |(X b) v j| * |D.ofLp j| := by simp only [abs_mul]
      _ ≤ ∑ j, |(X b) v j| * ‖D‖ := by
        exact Finset.sum_le_sum fun j _hj =>
          mul_le_mul_of_nonneg_left (hcoord j) (abs_nonneg _)
      _ = (∑ j, |(X b) v j|) * ‖D‖ := by rw [Finset.sum_mul]
  have hsum : (∑ v, |ceLogits (X b) D v|) ≤
      CEGroupedScale.featureAbsSum (X b) * ‖D‖ := by
    calc
      (∑ v, |ceLogits (X b) D v|) ≤
          ∑ v, (∑ j, |(X b) v j|) * ‖D‖ :=
        Finset.sum_le_sum fun v _hv => hlogit v
      _ = CEGroupedScale.featureAbsSum (X b) * ‖D‖ := by
        rw [CEGroupedScale.featureAbsSum, Finset.sum_mul]
  have hsq : (∑ v, |ceLogits (X b) D v|) ^ 2 ≤
      (CEGroupedScale.featureAbsSum (X b) * ‖D‖) ^ 2 := by
    have hnonneg : 0 ≤ ∑ v, |ceLogits (X b) D v| := by positivity
    nlinarith [mul_self_le_mul_self hnonneg hsum]
  have hfeature : (CEGroupedScale.featureAbsSum (X b)) ^ 2 ≤
      ∑ c, (CEGroupedScale.featureAbsSum (X c)) ^ 2 :=
    Finset.single_le_sum
      (fun c _hc => sq_nonneg (CEGroupedScale.featureAbsSum (X c)))
      (Finset.mem_univ b)
  calc
    (dirRange (X b) D) ^ 2 = 4 * (∑ v, |ceLogits (X b) D v|) ^ 2 := by
      unfold dirRange
      ring
    _ ≤ 4 * (CEGroupedScale.featureAbsSum (X b) * ‖D‖) ^ 2 :=
      mul_le_mul_of_nonneg_left hsq (by norm_num)
    _ = (4 * (CEGroupedScale.featureAbsSum (X b)) ^ 2) * ‖D‖ ^ 2 := by ring
    _ ≤ (4 * ∑ c, (CEGroupedScale.featureAbsSum (X c)) ^ 2) * ‖D‖ ^ 2 :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hfeature (by norm_num)) (sq_nonneg _)
    _ = batchFeatureRangeCoefficient X * ‖D‖ ^ 2 := rfl

/-- At nonnegative eta the actual displacement satisfies the range premise
needed by the existing `lse_shift_upper`, with no premise omitted. -/
theorem dir_displacement_range {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    {eta : ℝ} (heta : 0 ≤ eta) (u v : V) :
    (ceLogits X (alongNext θ D eta) u - ceLogits X θ u)
      - (ceLogits X (alongNext θ D eta) v - ceLogits X θ v)
      ≤ eta * dirRange X D := by
  have hsub : ∀ w : V, |ceLogits X D w| ≤ ∑ z, |ceLogits X D z| := by
    intro w
    exact Finset.single_le_sum
      (fun z _hz => abs_nonneg (ceLogits X D z)) (Finset.mem_univ w)
  have htri : ceLogits X D u - ceLogits X D v ≤
      |ceLogits X D u| + |ceLogits X D v| := by
    exact le_trans (le_abs_self _) (abs_sub _ _)
  rw [ceLogits_alongNext_apply, ceLogits_alongNext_apply]
  have hmul := mul_le_mul_of_nonneg_left
    (add_le_add (hsub u) (hsub v)) heta
  have hmul' := mul_le_mul_of_nonneg_left htri heta
  dsimp [dirRange]
  linarith

/-- Zero range is exactly joint vanishing of all directional logits. -/
theorem dirRange_eq_zero_iff {V : Type} [Fintype V] {d : ℕ}
    (X : Matrix V (Fin d) ℝ) (D : EuclideanSpace ℝ (Fin d)) :
    dirRange X D = 0 ↔ ∀ v, ceLogits X D v = 0 := by
  constructor
  · intro hr v
    have hsum : ∑ w, |ceLogits X D w| = 0 := by
      dsimp [dirRange] at hr
      linarith
    have habs := (Finset.sum_eq_zero_iff_of_nonneg
      (fun w _hw => abs_nonneg (ceLogits X D w))).mp hsum
      v (Finset.mem_univ v)
    exact abs_eq_zero.mp habs
  · intro hv
    simp [dirRange, hv]

/-- General one-example Böhning upper bound along an arbitrary direction. -/
theorem ceOneHot_alongNext_le_majorizer {V : Type} [Fintype V] [Nonempty V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) {eta : ℝ} (heta : 0 ≤ eta) :
    Hagi.ceOneHot t (ceLogits X (alongNext θ D eta)) ≤
      dirMajorizer X θ t D eta := by
  have hlse := Hagi.Energy.lse_shift_upper (ceLogits X θ)
    (ceLogits X (alongNext θ D eta)) (eta * dirRange X D)
    (dir_displacement_range X θ D heta)
  have hlin := dir_first_order_eq X θ D t eta
  have ht := ceLogits_alongNext_apply X θ D eta t
  classical
  have honehot : ∑ v, (if v = t then (1 : ℝ) else 0) *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      ceLogits X (alongNext θ D eta) t - ceLogits X θ t := by
    simp
  simp only [ceResidual, sub_mul, Finset.sum_sub_distrib] at hlin
  rw [honehot, ht] at hlin
  have hsoft : ∑ v, Hagi.Energy.smax (ceLogits X θ) v *
      (ceLogits X (alongNext θ D eta) v - ceLogits X θ v) =
      eta * dirAction X θ t D + eta * ceLogits X D t := by
    linarith
  rw [hsoft] at hlse
  unfold Hagi.ceOneHot Hagi.Core.lse
  unfold dirMajorizer
  rw [ht]
  dsimp [Hagi.Core.ceOneHot, Hagi.Core.lse]
  linarith

/-- Expanded general majorization certificate, retaining eta and range. -/
theorem ceOneHot_alongNext_le {V : Type} [Fintype V] [Nonempty V]
    {d : ℕ} (X : Matrix V (Fin d) ℝ) (θ D : EuclideanSpace ℝ (Fin d))
    (t : V) {eta : ℝ} (heta : 0 ≤ eta) :
    Hagi.ceOneHot t (ceLogits X (alongNext θ D eta)) ≤
      Hagi.ceOneHot t (ceLogits X θ) + eta * dirAction X θ t D
        + (eta * dirRange X D) ^ 2 / 8 :=
  ceOneHot_alongNext_le_majorizer X θ D t heta


end Hagi.Model.BatchCEDescent
