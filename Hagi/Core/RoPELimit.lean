import Hagi.Core.RoPE

set_option linter.style.header false

/-!
# RoPELimit — предел длины контекста: дихотомия
семантика/позиция

Формализация ядра Theorem 1 из «RoPE at the End of Its
Rope?» (arXiv:2609.39929, Wu–Du–Peng): при фиксированном
score-margin за пределами контекстного предела M_max
невозможно ОДНОВРЕМЕННО удерживать

  (a) семантическую стабильность: p_rev(M) ≤ δ
      (вероятность семантического перепутывания в допуске);
  (b) позиционную чувствительность: g(m) ≥ ζ для соседних
      позиций (нормализованный adjacent-response).

Высокочастотные компоненты управляют обоими требованиями:
подавление осцилляций стабилизирует порядок токенов ценой
потери локальной чувствительности — расширяющееся окно
оставляет всё меньше статических компонент.

Доказано:
* `rope_context_dichotomy`: калибровочная связь (ИЗМЕРЯЕМАЯ
  посылка h_emp_: полная adjacent-response-гарантия на
  калиброванном окне индуцирует строгий нижний предел
  p_rev) ⟹ за M_max дихотомия: ЛИБО p_rev > δ, ЛИБО
  существует позиция с g < ζ;
* `rope_limit_irreversible`: p_rev не убывает по M
  (посылка-контракт; содержательный факт статьи —
  расширяющееся окно не возвращает надёжность) ⟹
  превышение порога δ необратимо: все бОльшие окна тоже
  нарушают (a).

Честная граница: калибровочная связь и p_rev-монотонность —
эмпирические контракты спектрального профилировщика статьи
(нужны моменты оценок в конечных окнах — Proposition 1);
формализована ЛОГИКА предела: дихотомия и необратимость.
Полная вероятностная машина (Φ_std-аппроксимации,
гауссовские моменты) — вне этого слоя.
-/

open Finset

namespace Hagi.RoPELimit

/-- Дихотомия контекстного предела: если калибровочная
связь (hcal: полная adjacent-гарантия на окне M > M_max
индуцирует p_rev(M) > δ — измеряемый контракт), то за
пределом M_max НЕВОЗМОЖНО одновременно удержать p_rev ≤ δ и
g ≥ ζ везде: нарушается хотя бы одно. -/
theorem rope_context_dichotomy (M_max delta zeta : ℝ)
    (prev : ℝ → ℝ) (g : ℝ → ℝ)
    (hcal : ∀ M, M_max < M → (∀ m, m ≤ M - 2 → zeta ≤ g m)
      → delta < prev M) :
    ∀ M, M_max < M →
      (delta < prev M) ∨ (∃ m, m ≤ M - 2 ∧ g m < zeta) := by
  intro M hM
  by_cases hall : ∀ m, m ≤ M - 2 → zeta ≤ g m
  · exact Or.inl (hcal M hM hall)
  · push_neg at hall
    obtain ⟨m, hm⟩ := hall
    exact Or.inr ⟨m, hm.1, hm.2⟩

/-- Необратимость предела: p_rev не убывает по длине окна
(контракт статьи: расширяющееся окно только добавляет
медленные частоты в высокочастотную полосу) ⟹ первое
нарушение порога δ распространяется на ВСЕ бОльшие окна —
возврата к надёжности нет. -/
theorem rope_limit_irreversible (delta M1 : ℝ)
    (prev : ℝ → ℝ)
    (hmono : ∀ a b, a ≤ b → prev a ≤ prev b)
    (h1 : delta < prev M1) :
    ∀ M, M1 ≤ M → delta < prev M := by
  intro M hM
  exact lt_of_lt_of_le h1 (hmono M1 M hM)

end Hagi.RoPELimit
